<style type="text/css"> 
    #required_field {         
      position: absolute;
      bottom: px;
      left: 7px;
      font-size: 18px;
      color: red;
    }
</style>

<div class="container-fluid">
  <div class="row">
    <div class="col-sm-1" >      
    </div>

    <div class="col-sm-10" >
      <%= bootstrap_form_with(model: kpi_assignment, local: true) do |form| %>
        <% if kpi_assignment.errors.any? %>
          <div id="error_explanation">
            <ul>
              <% kpi_assignment.errors.full_messages.each do |message| %>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% session[:kpi_assignment_id] = @kpi_assignment.id %>

        <div class="panel panel-default" id="panelframe" style="">
          <div class="panel-heading" id="panelheader" >
            <i class="fas fa-calendar-check"></i> <strong>KPI Evaluation</strong>
          </div>

          <div class="panel-body">
            <div class="row">
              <div class="col-sm-4" >
                <div class="row">
                  <div class="col-sm-12" >
                  <small>
                    <div class="row">                      
                      <div class="col-sm-4" >
                        <strong>ID: </strong>
                      </div>

                      <div class="col-sm-8" >
                        <%=  @kpi_assignment.ID %>
                      </div>                                                                                
                    </div>

                    <div class="row">
                      <div class="col-sm-12" >
                        <p id="required_field"> *</p>
                        <%= form.collection_select :EvalPurposeRefNo, KpiEvalPurpose.where(IsActive: 1),:ID, :Description, label: 'Purpose' %>
                      </div>
                    </div>

                    <div class="row">
                      <div class="col-sm-12" >
                        <p id="required_field"> *</p>
                        <%= form.collection_select :EmployeeRefNo, PisEmployeeU.where(IsActive: 1),:EmployeeRefNo, :Description, label: 'Employee' %>
                      </div>
                    </div>
                    
                    <div class="row">
                      <div class="col-sm-12" >
                        <p id="required_field"> *</p>
                        <%= form.collection_select :PerformancePercentageID, KpiPerformancePercentage.where(ID: 3),:ID, :Description, label: '% Weight' %>
                      </div>
                    </div>
                    
                    <div class="row">
                      <div class="col-sm-6" >
                      <div class="row"> 
                        <div class="col-sm-12" >
                          <p id="required_field"> *</p>
                          <%= form.date_field :StartDate, label: 'Start Date', min: '2020-01-01', max: '2030-01-01' %>
                      </div>
                      </div>
                      </div>
                      
                      <div class="col-sm-6" >
                      <div class="row">                        
                        <div class="col-sm-12" >
                          <p id="required_field"> *</p>
                          <%= form.date_field :EndDate, label: 'End Date', min: '2020-01-01', max: '2030-01-01' %>
                        </div>
                      </div>
                      </div>
                    </div> 
                    
                    <div class="row">
                      <div class="col-sm-12" >
                        <p id="required_field"> *</p>
                        <%= form.date_field :SubmissionDate, label: 'Due Date', min: '2020-01-01', max: '2030-01-01' %>
                      </div>
                    </div> 
                    
                    <div class="row">   
                      <div class="col-sm-12" >                   
                        <%= form.text_area :Remarks, class: 'form-control input-sm', style: 'resize: none;' %>
                      </div>
                    </div>                   

                    <div class="row">                      
                      <div class="col-sm-4" >
                        <strong>Status: </strong>
                      </div>

                      <div class="col-sm-8" >
                        <%= GenFilingStatusF.where(FilingStatusRefNo: @kpi_assignment.FilingStatusRefNo ).pluck(:Description).to_sentence %>
                      </div>
                    </div>
                  </small>  
                  </div>
                </div>

                <div class="row">
                  <div class="col-sm-12" >

                    <br>
                    <br>

                    <div class="row">
                      <% if @kpi_assignment.FilingStatusRefNo.to_i != 40 && @kpi_assignment.FilingStatusRefNo.to_i != 2 %>
                        <div class="col-sm-6" >
                          <%= form.submit 'Save', class:'btn btn-success btn-sm btn-block', id: 'submit_detail_but' %>
                        </div>

                        <script type="text/javascript">
                          $(document).submit(function() {
                            $( "#submit_detail_but" ).prop('disabled', true);
                          });                      
                        </script>                 
                      <% end %>

                      <div class="col-sm-6" >
                        <%= link_to 'Delete', kpi_assignment, method: :delete, data: { confirm: 'Are you sure you want to delete this application?', disable_with: "<i class='fa fa-spinner fa-spin'></i> Please wait..." },  class: "btn btn-primary btn-block" %>                                       
                      </div>
                    </div>
                    
                    <br>

                    <div class="row">                      
                      <div class="col-sm-12" >
                        <%= link_to "Request", post_kpi_path(kpi_id: @kpi_assignment.ID), method: 'post',  class: "btn btn-primary btn-block", data: { confirm: 'Are you sure you want to request this application?', disable_with: "<i class='fa fa-spinner fa-spin'></i> Please wait..." } %>
                      </div>
                    </div>

                    <br>

                    <%= link_to 'Back to List', kpi_assignments_path, class:'btn btn-primary  btn-block' %>
                  </div>
                </div>
              <% end #  end of form%>
            </div>

            <% if mobile_device == "mobile" %>
              <div class="col-sm-8" >
            <% else %>
              <div class="col-sm-8"  style="border-left-style: dotted; border-color: #555555;" >
            <% end %>            

               <% if @kpi_assignment.FilingStatusRefNo.to_i != 0 %>
                <iframe src="/kpi_core_competencies/<%= @get_edit_id.to_param %>/edit" style="border:none;" title="IframeExpenseDetails" height="530px" width="100%"></iframe>              
              <% else %>
                <iframe src="/showkpireport" style="border:none;" title="IframeExpenseDetails" height="530px" width="100%"></iframe>              
              <% end %>  
            </div>
          </div>
        </div>
      </div>      
    </div>

    <div class="col-sm-1" >      
    </div>
  </div>
</div>

<br>
<br>