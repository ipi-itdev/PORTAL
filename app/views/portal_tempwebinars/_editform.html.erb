<style type="text/css">
  
#header_one {
  font-size: 200%;
}


#panelwebinar{
  box-shadow: 0 0px 2px 0 rgba(0, 0, 0, 1);
}

#panelheaderwebinar {
background: rgb(63 81 185);

}

#webinar_required{
  position: absolute;
  bottom: px;
  left: 115px;
  font-size: 15px;
  color: red;
}

#webinar_required_modal{
  position: absolute;
  bottom: px;
  left: 323px;
  font-size: 15px;
  color: red;
}

#reason_tag{
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    box-sizing: border-box;

    width: 100%;
}




</style>


<div class="container"> 
 <div class="row">
    <div class="col-sm-3" >
      
    </div>

    <div class="col-sm-6">

      <div class="panel panel-default" id="panelwebinar">
        <div class="panel-heading" id="panelheaderwebinar"></div>
        <div class="panel-body">
          <%= bootstrap_form_with(model: portal_tempwebinar, local: true) do |form| %>

          <p id="header_one">Webinar Registration: Stress Coping and Well-being in Times of Crisis</p>
          <p id="header_two">October 2, 2020 | Friday | 4:30 - 5:30 PM</p>
          <p style="color: red;">* Required</p>
        </div>
      </div>
  



      <div class="panel panel-default" id="panelwebinar">
        <div class="panel-body">
          <%= form.hidden_field :EmployeeRefNo, value: current_user.EmployeeRefNo %>

          <% emp_details = PisEmployeeU.where(EmployeeRefNo: current_user.EmployeeRefNo).pluck(:Description).to_sentence %>
          <% emp_details1 = PisEmployeeU.where(EmployeeRefNo: current_user.EmployeeRefNo).pluck(:NickName).to_sentence %>
          <% getfname  = PisEmployeeU.where(EmployeeRefNo: current_user.EmployeeRefNo).pluck(:FirstName).to_sentence %>
          <% get_mobile  = PisEmployeeU.where(EmployeeRefNo: current_user.EmployeeRefNo).pluck(:MobileNumber).to_sentence %>
          <% get_email  = PisEmployeeU.where(EmployeeRefNo: current_user.EmployeeRefNo).pluck(:PersonalEmailAddress).to_sentence %>


          <h4>Name: <%= emp_details %> </h4>

          <% if emp_details1.empty? == true %>
            <h4>Nickname: <%= getfname %> </h4>
            <%= form.hidden_field :Nickname, value: getfname %>
          <% else %>
            <h4>Nickname: <%= emp_details1 %> </h4>
            <%= form.hidden_field :Nickname, value:  emp_details1 %>
          <% end %>
          <%= form.hidden_field :Name, value: emp_details %>
          <hr>

          <div class="row">
            <div class="col-sm-6" >
              <p id="webinar_required"> *</p>
              <%= form.text_field :Email,  label:'Email Address', placeholder:'Your Answer'  %>
              
            </div>
            <div class="col-sm-6" >
              <%= form.text_field :Mobilenumber,  label:'Mobile Number', placeholder:'Your Answer' %>
            </div>
          </div>

          <%= form.text_area :PossibleQuestion, label:'Your possible questions to the speaker during the Live Webinar' %>

          <div class="row">
            <div class="col-sm-6" >
              <%= form.submit 'Update', class:'btn btn-primary  btn-block' %>
            </div>
            <div class="col-sm-6" >

            	<button type="button" class="btn btn-primary btn-block" data-toggle="modal" data-target="#exampleModal">
				  Cancel Registration
				</button>
              
            </div>
          
          </div>


        </div>
      </div>

      <% end %>

      <br>
      <br>
      <br>
      <br>
      <br>

    </div>


    </div>

    <div class="col-sm-3" >
      
    </div>
 </div>


<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
      	<p id="webinar_required_modal"> *</p>
        <b>Your Reason why you cancel your registration</b>
      </div>
      <div class="modal-body">
       <%= form_tag('/cancel_webinar_reg') do %>

      	<% portal_tempwebinar.id %>
      	<%= hidden_field_tag :id, portal_tempwebinar.id %>
      	
      	<textarea name="reason_tag" id="reason_tag" ></textarea>

      </div>
      <div class="modal-footer">
      	<div class="row">
            <div class="col-sm-6" >
            	<%= submit_tag 'Proceed', class:'btn btn-primary btn-block', id: 'proceed_button' %>
            </div>
            <div class="col-sm-6" >
            	<button type="button" class="btn btn-secondary btn-block" data-dismiss="modal">Close</button>
            </div>
        </div>

     
    
        <% end %>
      </div>
    </div>
  </div>

<script type="text/javascript">
	if ($("#reason_tag").val() == '' ) 
    {	

     $( "#proceed_button" ).prop('disabled', true);

    }
  
  else
    {

     $( "#proceed_button" ).prop('disabled', false);
    }

	

</script>


<script type="text/javascript">

  $( "#reason_tag" ).focusout(function() {

	if ($("#reason_tag").val() == '' ) 
    {	
     $( "#proceed_button" ).prop('disabled', true);

    }
  
  else
    {

     $( "#proceed_button" ).prop('disabled', false);
    }

	});
</script>

<!--- end  hrs checker --->

