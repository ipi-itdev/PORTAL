<%  @portal_homeposter_us.where(HomePosterRefno: 5).each do |postersec| %>
  <% if current_page?(:controller => 'portal_homeposter_us', :action => 'index') %>
  <div align="left">
      <b><%= postersec.Description %></b>: 
      <% if postersec.IsVisible == true %>
        <b>Visible:</b> True
      <% else %>
        <b>Visible:</b> False
      <% end %>
      /
      <% if postersec.IsSlides == true  %>
        <b>On Slides:</b> True
      <% else %>
        <b>On Slides:</b> False
      <% end %>
      /
      <b>Duration:</b> <%= postersec.StartDate.to_date %> to <%= postersec.EndDate.to_date %>

  </div>

  <% end %>

  <% if postersec.IsVisible %>

    <% if Date.today.between?(postersec.StartDate, postersec.EndDate) == true %>

      <% if postersec.IsSlides == true %>
        <div class="panel panel-default" id="panelframe" align="center">
          <div id="myCarousel<%= postersec.id %>" class="carousel slide" data-ride="carousel">

            <!-- Wrapper for slides -->

            <div class="carousel-inner" role="listbox">
              <% @portal_homehposter_details.where(HomePosterRefno: 5).order(:SeqNumber).each_slice(1).with_index do |slice, index| %>
                <div class="item <%= 'active' if index == 0 %>">
                <% slice.each do |slice1| %>
                    <img src="<%= slice1.Image %>" style="width: 100%; height: 100%" >
                <% end %>
                </div>  
              <% end %>
            </div>

            <!-- Left and right controls -->
            <a class="left carousel-control" data-target="#myCarousel<%= postersec.id %>" data-slide="prev">
              <span class="glyphicon glyphicon-chevron-left"></span>
              <span class="sr-only">Previous</span>
            </a>
            <a class="right carousel-control" data-target="#myCarousel<%= postersec.id %>" data-slide="next">
              <span class="glyphicon glyphicon-chevron-right"></span>
              <span class="sr-only">Next</span>
            </a>
          </div>
        </div>

      <% else %>
        <% @portal_homehposter_details.where(HomePosterRefno: 5).order(:SeqNumber).each do |sec|%>
          <img src="<%= sec.Image %>"  style="width:100%;height:100%;">
        <% end %>
      <% end %>

    <% end %>

  <% end  %>

<% end %>


