
<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>

  <style type="text/css">
    #required_field {
      position: absolute;
      bottom: px;
      left: 7px;
      font-size: 18px;
      color: red;
    }

    #seqnum_add{
      pointer-events: none;
      border: 1px solid grey;
      background-color: lightgrey;
       appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      user-select: none;
    }

  </style>
</head>

<body>
  <div class="container-fluid">
    <%= bootstrap_form_with(model: portal_homeposter_detail, local: true) do |form| %>
      <% if portal_homeposter_detail.errors.any? %>
        <div id="error_explanation_details">
          <ul>
            <p style="color: red;font-size: 80%;">
              <% portal_homeposter_detail.errors.full_messages.each do |message_err| %>
                <small><%= message_err %></small>
                 <br>
              <% end %>
            </p>
          </ul>
        </div>
      <% end %>

      <ul><p style="color: red;font-size: 80%;"><%= flash.now[:message] = "#{@warning}" %></p></ul>

      <div class="row">
        <div class="col-sm-6" >
          <%= form.hidden_field :HomePosterRefno, value: session[:set_base_homeposter_refno] %>
          <%= form.hidden_field :IsActive, value: true %>
          <p id="required_field"> *</p>
          <%= form.text_field :Description %>
          <p id="required_field"> *</p>
                                                
          <% if params[:action] == 'edit' || params[:action] == 'update' %>
            <%= form.number_field :SeqNumber, label: 'Seq. Number', min: '1', max: '50', id: 'seqnum_edit' %>
          <% else %>
            <%= get_last_seq = PortalHomeposterDetail.where(HomePosterRefno: session[:set_base_homeposter_refno].to_i).pluck(:SeqNumber).to_sentence.last
%>
            <%= form.number_field :SeqNumber, label: 'Seq. Number', min: '1', max: '50', value:  get_last_seq.to_i + 1, :readonly => true, id: 'seqnum_add' %>
          <% end %>
            <%= form.hidden_field :get_id, value: portal_homeposter_detail.id %>

        </div>

        <div class="col-sm-6" >


          <p id="required_field"> *</p>                                          
          <%= form.file_field :Image, label: 'Attach Image', onchange: "myFunction_hidediv()", :accept => 'image/jpeg,image/jpg,image/png,image/gif,application/pdf' %>

          <script type="application/javascript">
              $('input[type="file"]').change(function(e){
                  var fileName = e.target.files[0].name;
                  $('.custom-file-label').html(fileName);
              });
          </script>

          <script>
            function myFunction_hidediv() {
              var x = document.getElementById("portal_homeposter_detail_Image").value;
              $("#div_filepath").hide();
            }
          </script>  

          <div id="div_filepath">
            <small><a href="<%= @portal_homeposter_detail.Image %>" target="_blank"> <%= @portal_homeposter_detail.Image_identifier %> </a> </small>
          </div>

          <small><%= form.hidden_field :Image_cache %></small>    
          <small style="color: red;">*Allowed files: jpg, jpeg, and png  (2mb max file size)</small> 
          <br>
          <br>
          <div class="row">
            <div class="col-sm-6" >
              <%= form.submit 'Save', class:'btn btn-success btn-sm btn-block', id: 'submit_detail_but' %>
            </div>

            <script type="text/javascript">
              $(document).submit(function() {
                $( "#submit_detail_but" ).prop('disabled', true);
              });                      
            </script>

            <div class="col-sm-6" >
              <%= link_to 'Back to List', portal_homeposter_details_path(homeposter_refno: session[:set_base_homeposter_refno]), class:'btn btn-primary btn-sm btn-block' %>
            </div>
            
          </div>



        </div>
      </div>



      <br>
      <br>  

      <div class="row">
        <div class="col-sm-6" >
        </div>

        <div class="col-sm-6" >

        </div>
      </div>
    <% end %>
  </div>

<script type="text/javascript">
    $('#portal_ot_application_detail_AttachmentFile').on('change', function() {
      var numb = $(this)[0].files[0].size / 1024 / 1024;
    numb = numb.toFixed(2);
    if (numb > 2) 
    {
      alert('to big, maximum is 2MiB. You file size is: ' + numb + ' MiB');
      $( "#submit_detail_but" ).prop('disabled', true);
    } 
    else 
    {
      $( "#submit_detail_but" ).prop('disabled', false);
    }   
    });
  </script>


</body>
</html>
