<% if session[:show_bir_forms] == true %>

	<% if PortalBirUploadDetail.where(EmployeeRefNo: current_user.EmployeeRefNo).exists? == false %>

		<small><p align="center" style="color: red;">If you haven't upload your signed BIR 2316, click the link below</p></small>
		<p align="center"><%= link_to 'Click here to upload signed 2316 ', '/portal_bir_upload_details/new', method:'get' %></p>

	<% else %>
	<p style="color: blue;">You already uploaded your BIR2316,  <%= link_to 'click here to view', '/portal_bir_uploaded_list', method:'get' %> </p>

	<% end %> 
<% end %>



	
