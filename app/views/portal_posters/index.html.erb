<p id="notice"><%= notice %></p>

<h1>Portal Posters</h1>

<table>
  <thead>
    <tr>
      <th>Description</th>
      <th>Date post</th>
      <th>Poster refno</th>
      <th>Attachedfile</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @portal_posters.each do |portal_poster| %>
      <tr>
        <td><%= portal_poster.description %></td>
        <td><%= portal_poster.date_post %></td>
        <td><%= portal_poster.poster_refno %></td>
        <td><%= portal_poster.attachedfile %></td>
        <td><%= link_to 'Show', portal_poster %></td>
        <td><%= link_to 'Edit', edit_portal_poster_path(portal_poster) %></td>
        <td><%= link_to 'Destroy', portal_poster, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Portal Poster', new_portal_poster_path %>
