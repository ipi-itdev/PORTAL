<p id="notice"><%= notice %></p>

<h1>Userheros</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Login</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @userheros.each do |userhero| %>
      <tr>
        <td><%= userhero.name %></td>
        <td><%= userhero.email %></td>
        <td><%= userhero.login %></td>
        <td><%= link_to 'Show', userhero %></td>
        <td><%= link_to 'Edit', edit_userhero_path(userhero) %></td>
        <td><%= link_to 'Destroy', userhero, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Userhero', new_userhero_path %>
