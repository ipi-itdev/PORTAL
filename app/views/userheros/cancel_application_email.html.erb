
<!DOCTYPE html>
<html>
<head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />




</head>
  <body>
  		<% @get_approver_submit_details_header.each do |get_approver_submit_details|%>  


      <p>Hi All, </p>
      <br>
      <p>Leave Application has been  <b><%= PortalLeaveStatusC.where(status_refno: get_approver_submit_details.leave_status_refno).pluck(:status_description).to_sentence %></b></p>

      <p><b>Cancelled on: </b><%= get_approver_submit_details.modifieddate.to_date.strftime("%m/%d/%Y") %></p>

      <p><b>Cancelled by: </b><%= PisEmployeeU.where(EmployeeRefNo: get_approver_submit_details.modifiedby).pluck(:Description).to_sentence %> </p>

      <p><b>Remarks: </b><%= get_approver_submit_details.remarks %></p>
      <br>

      <hr>
      <h3>Details:</h3>

          <table width="60%" style="border:1px solid #333">

        <tr style="border:1px solid #333">
            <td width="20%" style="border:1px solid #333"><strong>Reference No.</strong></td>
            <td width="80%" align="left" style="border:1px solid #333"> <%= get_approver_submit_details.id %></td>
            </tr>

            <tr style="border:1px solid #333">
            <td width="20%" style="border:1px solid #333"><strong>Employee Name</strong></td>
            <td width="80%" align="left" style="border:1px solid #333">

              <% hash_emp_details =  PisEmployeeU.where(EmployeeRefNo:get_approver_submit_details.employeerefno).pluck_to_hash(:Description, :EmployeeNumber) %>
              <% emp_details = hash_emp_details[0]%>
              <%= emp_details[:Description] %> - <%= emp_details[:EmployeeNumber] %>   
            </td>
            </tr>

        <tr style="border:1px solid #333">
            <td width="20%" style="border:1px solid #333"><strong>Previous Status</strong></td>
            <td width="80%" align="left" style="border:1px solid #333"><%= PortalLeaveStatusC.where(status_refno: @get_previous_details).pluck(:status_description).to_sentence  %></td>
            </tr>

            <tr style="border:1px solid #333">
            <td width="20%" style="border:1px solid #333"><strong>Leave Type</strong></td>
            <td width="80%" align="left" style="border:1px solid #333"><%=  GenLeaveTypeM.where(LeaveTypeRefNo: get_approver_submit_details.leavetype_refno).pluck(:Code).to_sentence %></td>
            </tr>

            <tr style="border:1px solid #333">
            <td width="20%" style="border:1px solid #333"><strong>Date Filed</strong></td>
            <td width="80%" align="left" style="border:1px solid #333"><%=  get_approver_submit_details.date_filed.strftime("%m/%d/%Y") %></td>
            </tr>

            <tr style="border:1px solid #333">
            <td width="20%" style="border:1px solid #333"><strong>Hour(s)</strong></td>
            <td width="80%" align="left" style="border:1px solid #333"><%= PortalLeaveTimeLookupU.where(leave_value: get_approver_submit_details.end_hrs).pluck(:description).to_sentence %> </td>
            </tr>

            <tr style="border:1px solid #333">
            <td width="20%" style="border:1px solid #333"><strong>Start Date</strong></td>
            <td width="80%" align="left" style="border:1px solid #333"><%= get_approver_submit_details.startdate.strftime("%m/%d/%Y")%> </td>
            </tr>

            <tr style="border:1px solid #333">
            <td width="20%" style="border:1px solid #333"><strong>End Date</strong></td>
            <td width="80%" align="left" style="border:1px solid #333"><%= get_approver_submit_details.enddate.strftime("%m/%d/%Y") %></td>
            </tr> 

            <tr style="border:1px solid #333">
            <td width="20%" style="border:1px solid #333"><strong>Reason</strong></td>
            <td width="80%" align="left" style="border:1px solid #333"><%= get_approver_submit_details.reason %></td>
            </tr> 
       
          </table>
          <% end %>
       
          <hr>
          <p>This is a system generated email. Please do not reply.</p>
          <p>IPI Employee Portal.</p>





  </body>
</html>