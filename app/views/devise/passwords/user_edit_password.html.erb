<!DOCTYPE html>
<html>
<head>


 <script src="https://cdnjs.cloudflare.com/ajax/libs/zxcvbn/4.4.2/zxcvbn.js" integrity="sha512-TZlMGFY9xKj38t/5m2FzJ+RM/aD5alMHDe26p0mYUMoCF5G7ibfHUQILq0qQPV3wlsnCwL+TPRNK4vIWGLOkUQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script> 
 
<%= stylesheet_link_tag    'registration_edit' %>
<%= javascript_include_tag  'registration_edit' %>


<style>
        meter[value="1"]::-webkit-meter-optimum-value { background: red; }
        meter[value="2"]::-webkit-meter-optimum-value { background: yellow; }
        meter[value="3"]::-webkit-meter-optimum-value { background: orange; }
        meter[value="4"]::-webkit-meter-optimum-value { background: green; }

        meter[value="1"]::-moz-meter-bar { background: red; }
        meter[value="2"]::-moz-meter-bar { background: orange; }
        meter[value="3"]::-moz-meter-bar { background: orange; }
        meter[value="4"]::-moz-meter-bar { background: green; }


        .form-gap {
         padding-top: 70px;
  }
</style>

</head>


<body>



<div class="container-fluid">
  <div class="row">
    <div class="col-sm-4" >
      <!---empty -->
    </div>
    <div class="col-sm-4" >

      <div class="panel panel-info" id="panelframe">
        <div class="panel-heading" id="panelheader">
        	<h3 align="center">Change Password</h3>
        </div>
        <div class="panel-body">


        	<%= form_tag("/user_update_password", method: "post") do %>
			  <%= password_field_tag :password, nil,autocomplete: "new-password", placeholder: 'Enter New Password',label: "New Password", id: 'newPassword', name:'newPass', class:'form-control'  %>


                <div class="form-group" style="margin-left: 15px; margin-right: 15px" align="center">
                    <div class="input-group text-center">
                        <meter max="4" value="0" id="password-strength-meter" style="width: 200px; visibility: hidden"></meter>
                        <small><p id="password-strength-text" style="color: dimgray"></p></small>
                    </div>
                </div>

			  <%= password_field_tag(:password_confirmation, nil,autocomplete: "new-password", placeholder: 'Confirm New Password', label: " Confirm New Password", id:'confirmPassword', name: 'confirmPass', class:'form-control') %>

			<div class="form-group" style="margin-left: 15px; margin-right: 15px">
                <div class="input-group text-center">
                    <meter max="4" value="0" id="password-strength-meter" style="width: 32px; visibility: hidden"></meter>
                    <small><p id="password-strength-text" style="color: dimgray"></p></small>
                </div>
            </div>

            <%= hidden_field_tag 'emprefno', current_user.EmployeeRefNo %>
            
			  <%= submit_tag("Save", class: "btn btn-primary  btn-block btn-sm", id: 'btnReset', method:'post') %>
			<% end %>


    </div>
    <div class="col-sm-4" >
      <!---empty -->
    </div>
  </div>
</div>
<br>
<br>
<br>




    <script type="text/javascript">
        
        var strength = {
            0: "Worst ☹",
            1: "Bad ☹",
            2: "Weak ☹",
            3: "Good ☺",
            4: "Strong ☻"
        }

        var reset = document.getElementById('btnReset');
        var password = document.getElementById('newPassword');
        var meter = document.getElementById('password-strength-meter');
        var text = document.getElementById('password-strength-text');

        password.addEventListener('input', function () {
            var val = password.value;
            var result = zxcvbn(val);

            // Update the password strength meter
           
            meter.value = result.score;

            if (parseInt(result.score) >= 3) {
                reset.disabled = false;
            } else { reset.disabled = true; }


            // Update the text indicator
            if (val !== "") {
                meter.style.visibility = "visible";
                text.innerHTML = "Strength: " + "<strong>" + strength[result.score] + "</strong>" + "<br><span class='feedback'>" + result.feedback.warning + " " + result.feedback.suggestions + "</span";
            }
            else {
                meter.style.visibility = "hidden";
                text.innerHTML = "";
            }
        });

        function ResetPassword() {
        
            var txtNew =  document.getElementById('newPassword').value;
            var txtConfirm = document.getElementById('confirmPassword').value;

            if ((!txtNew.replace(/\s/g, '').length) || (!txtConfirm.replace(/\s/g, '').length)) {

                swal({
                    title: "Unable to proceed..",
                    text: "Password cannot be empty.",
                    icon: "warning",
                    button: "OKAY",
                });

                return false;

            } else {

                if (txtNew != txtConfirm) {

                    swal({
                        title: "Unable to proceed..",
                        text: "New and Confirm Password did not match.",
                        icon: "error",
                        button: "OKAY",
                    });

                    return false;
                } else {

                    var pass = txtNew;
                    $("#MainContent_UserPass").val(pass);
                    var clickButton = document.getElementById("MainContent_btnResetFinal");
                    clickButton.click();
                    return false;
                }
            }
        }


        $(document).keypress(function (e) {
            if (e.keyCode === 13) {
                e.preventDefault();
                return false;
            }
        });
    
        var strength = {
            0: "Worst ☹",
            1: "Bad ☹",
            2: "Weak ☹",
