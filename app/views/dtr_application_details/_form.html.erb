<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>

  <style type="text/css">
    #required_field {
      position: absolute;
      bottom: px;
      left: 7px;
      font-size: 18px;
      color: red;
    }
  </style>
</head>

<body>
  <div class="container-fluid">
    <%= bootstrap_form_with(model: dtr_application_detail, local: true) do |form| %>
      <% if dtr_application_detail.errors.any? %>
        <div id="error_explanation">
          <ul>
            <p style="color: red;font-size: 80%;">
              <% dtr_application_detail.errors.full_messages.each do |message| %>
                <%= message %> <br>
              <% end %>
            </p>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-sm-6" >                    
          <%= form.hidden_field :WeeklyScheduleRefNo, value: session[:dtr_app_id] %>
          <%= form.hidden_field :ModifiedBy, value: current_user.EmployeeRefNo %>
          <%= hidden_field_tag "base_id", "#{@hash_url_edit[:base_id]}" %>
          <%= hidden_field_tag "emprefno", "#{@hash_url_edit[:emprefno]}" %>
          <small><%= form.date_field :WorkDate, label: 'Date', :disabled => true %></small>         
        </div> 
        
        <div class="col-sm-6" >
        <small><%= form.text_field :DayStatus, label: 'Status', :disabled => true %></small>         
        </div>        
      </div>

      <div class="row">
        <div class="col-sm-6" >
          <small><%= form.time_field :TimeIn , label: 'Time In', :disabled => true %></small>        
        </div>

        <div class="col-sm-6" >
          <small><%= form.time_field :TimeOut , label: 'Time Out', :disabled => true %></small>        
        </div>
      </div>

      <div class="row">
        <div class="col-sm-6" >
          <small><%= form.text_area :Remarks, class: 'form-control input-sm', style: 'resize: none;' %></small>                
        </div>
      </div>      

      <div class="row">
        <div class="col-sm-12" >
        </div>
      </div>

      <br>
      <br>  

      <div class="row">
        <div class="col-sm-6" >
        </div>

        <div class="col-sm-6" >
          <div class="row">
            <div class="col-sm-6" >
              <%= form.submit 'Save', class:'btn btn-success btn-sm btn-block', id: 'submit_detail_but' %>
            </div>

            <script type="text/javascript">
              $(document).submit(function() {
                $( "#submit_detail_but" ).prop('disabled', true);
                $( "#dtr_detail_back_but" ).prop('disabled', true);
              });                      
            </script>

            <div class="col-sm-6" >
              <%= link_to 'Back to List', "/dtr_application_details?dtr_app_id=#{@hash_url_edit[:base_id]}&employeerefno=#{@hash_url_edit[:emprefno]} ", class:'btn btn-primary btn-sm btn-block', method: 'get', type:  'button', id:'dtr_detail_back_but' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</body>
</html>