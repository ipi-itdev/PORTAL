<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>

  <style type="text/css">  
    #required_field {
      position: absolute;
      bottom: px;
      left: 7px;
      font-size: 18px;
      color: red;
    }
  </style>
</head>

<body>
  <div class="container-fluid">
    <%= bootstrap_form_with(model: portal_ob_application_detail, local: true)  do |form| %>
      <% if portal_ob_application_detail.errors.any? %>
        <div id="error_explanation">
          <ul>
            <p style="color: red;font-size: 80%;">
              <% portal_ob_application_detail.errors.full_messages.each do |message| %>
                <%= message %> <br>
              <% end %>
            </p>
          </ul>
        </div>
      <% end %>

      <ul><p style="color: red;font-size: 80%;"><%= flash.now[:message] = "#{@warning}" %></p></ul>

      <div class="row">
        <div class="col-sm-6" >        
          <%= form.hidden_field :OBApplicationRefNo, value: session[:portal_ob_application_id] %>
          <%= form.hidden_field :EmployeeRefNo, value: current_user.EmployeeRefNo %>
          <%= form.hidden_field :CreatedDate, value: DateTime.now + 8.hours %>
          <%= form.hidden_field :CreatedBy, value: current_user.EmployeeRefNo %>
          <%= form.hidden_field :ModifiedDate, value: DateTime.now + 8.hours %>
          <%= form.hidden_field :ModifiedBy, value: current_user.EmployeeRefNo %>
          <%= form.hidden_field :IsActive, value: true %>
          <%= form.hidden_field :ServerCompanyCodeID, value: '1-1' %>          
          
          <small><%= form.collection_select :ClientAccountRefNo, GenClientAccountM.where(IsActive: 1),:ClientAccountRefNo, :Description, label: 'Client Account' %></small>            
        </div>

        <div class="col-sm-6" >    
          <p id="required_field"> *</p>    
          <small><%= form.text_area :Task, class: 'form-control input-sm', style: 'resize: none;', oninput: "this.value = this.value.replace(/'/g, '`')" %></small>        
        </div>
      </div>

      <div class="row">
        <div class="col-sm-6" >  
          <p id="required_field"> *</p>   
          <% if @edit == 1 || @edit == 0 %>
            <small><%= form.date_field :WorkDate, label: 'Date', min: '2020-01-01', max: '2030-01-01' %></small> 
          <% else %>
            <small><%= form.date_field :WorkDate, label: 'Date', min: '2020-01-01', max: '2030-01-01', onchange: 'fnOnChange()' %></small> 

            <script>
              function fnOnChange(){
                document.getElementById("portal_ob_application_detail_EndDate").value = document.getElementById("portal_ob_application_detail_WorkDate").value;              
              }
            </script>
          <% end %>  
        </div>

      </div>

      <div class="row">
        <div class="col-sm-6" >
          <p id="required_field"> *</p>
          <small><%= form.time_field :StartTime , label: 'Start Time' %></small>        
        </div>

        <div class="col-sm-6" >
          <p id="required_field"> *</p>
          <small><%= form.time_field :EndTime , label: 'End Time' %></small>        
        </div>
      </div>

      <div class="row">
        <div class="col-sm-12" >
        </div>
      </div>

      <br>
      <br>  

      <div class="row">
        <div class="col-sm-6" >
        </div>

        <div class="col-sm-6" >
          <div class="row">
            <div class="col-sm-6" >
              <%= form.submit 'Save', class:'btn btn-success btn-sm btn-block', id: 'submit_detail_but' %>
            </div>

            <script type="text/javascript">
              $(document).submit(function() {
                $( "#submit_detail_but" ).prop('disabled', true);
              });                      
            </script>

            <div class="col-sm-6" >
              <%= link_to 'Back to List', portal_ob_application_details_path, class:'btn btn-primary btn-sm btn-block' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</body>
</html>





