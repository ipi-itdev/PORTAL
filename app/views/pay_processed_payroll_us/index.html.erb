<!-- 13th month Modal -->
<div class="modal fade" id="13thmonthModal" tabindex="-1" role="dialog" aria-labelledby="13thmonthModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">

      <div class="modal-body">
      <div class="container-fluid">

            
         <% @get_emp_13thmonth.each do |get_emp_13thmonth|%>

          <div class="row">
            <table width="100%">
                
            </table>  
          </div>      

          <div class="row">

              <table  class="table table-bordered table-striped">
                <tr>
                  <td align="left"><strong>13th Month Amount (<%= @get_13thmonth_yr.rows[0][0] %>):</strong> </td>
                  <td align="right"> <%=  number_with_precision(get_emp_13thmonth.ThirteenthMonthPay, :precision => 2, :delimiter => ',') %> </td>
                </tr>

                <tr>
                  <td><strong>January:</strong> </td>
                  <td align="right"><%=  number_with_precision(get_emp_13thmonth.January, :precision => 2, :delimiter => ',') %></td>

                </tr>
                <tr>
                  <td><strong>February:</strong> </td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.February, :precision => 2, :delimiter => ',') %></td>

                </tr>
                <tr>
                  <td><strong>March:</strong></td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.March, :precision => 2, :delimiter => ',') %></td>

                </tr>
                <tr>
                  <td><strong>April:</strong></td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.April, :precision => 2, :delimiter => ',') %></td>
                </tr>
                <tr>
                  <td><strong>May:</strong></td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.May, :precision => 2, :delimiter => ',') %></td>
                </tr>
                <tr>
                  <td><strong>June:</strong></td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.June, :precision => 2, :delimiter => ',') %></td>
              
                </tr>
                <tr>  
                  <td><strong>July: </strong></td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.July, :precision => 2, :delimiter => ',') %></td>
                  
                </tr>
                <tr>
                  <td><strong>August:</strong></td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.August, :precision => 2, :delimiter => ',') %></td>
                 
                </tr>
                <tr>
                  <td><strong>September:</strong></td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.September, :precision => 2, :delimiter => ',') %></td>
                 

                </tr>
                <tr>
                  <td><strong>October:</strong></td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.October, :precision => 2, :delimiter => ',') %></td>
                 
                </tr>
                <tr>
                  <td><strong>November:</strong></td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.November, :precision => 2, :delimiter => ',') %></td>
                 
                </tr>
                <tr>
                  <td><strong>December:</strong></td>
                  <td align="right"><%= number_with_precision(get_emp_13thmonth.December, :precision => 2, :delimiter => ',') %></td>
                 
                </tr>



              </table>


           </div>
      </div>     
         <% end %>
        
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>


</body> 
</html>
