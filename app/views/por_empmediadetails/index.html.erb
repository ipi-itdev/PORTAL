<p id="notice"><%= notice %></p>

<h1>Por Empmediadetails</h1>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Employeerefno</th>
      <th>Starttime</th>
      <th>Timepaused</th>
      <th>Endtime</th>
      <th>Mediarefno</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @por_empmediadetails.each do |por_empmediadetail| %>
      <tr>
        <td><%= por_empmediadetail.id %></td>
        <td align="center"><%= por_empmediadetail.employeerefno %></td>
        <td><%= por_empmediadetail.starttime %></td>
        <td><%= por_empmediadetail.timepaused %></td>
        <td><%= por_empmediadetail.endtime %></td>
        <td><%= por_empmediadetail.mediarefno %></td>
        <td><%= link_to 'Show', por_empmediadetail %></td>
        <td><%= link_to 'Edit', edit_por_empmediadetail_path(por_empmediadetail) %></td>
        <td><%= link_to 'Destroy', por_empmediadetail, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Por Empmediadetail', new_por_empmediadetail_path %>
