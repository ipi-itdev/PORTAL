<p id="notice"><%= notice %></p>

<h1>Portal Leave Status Cs</h1>

<table>
  <thead>
    <tr>
      <th>Status description</th>
      <th>Status refno</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @portal_leave_status_cs.each do |portal_leave_status_c| %>
      <tr>
        <td><%= portal_leave_status_c.status_description %></td>
        <td><%= portal_leave_status_c.status_refno %></td>
        <td><%= link_to 'Show', portal_leave_status_c %></td>
        <td><%= link_to 'Edit', edit_portal_leave_status_c_path(portal_leave_status_c) %></td>
        <td><%= link_to 'Destroy', portal_leave_status_c, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Portal Leave Status C', new_portal_leave_status_c_path %>
