<p id="notice"><%= notice %></p>

<h1>Portal Empposter Details</h1>

<table>
  <thead>
    <tr>
      <th>Employeerefno</th>
      <th>Poster refno</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @portal_empposter_details.each do |portal_empposter_detail| %>
      <tr>
        <td><%= portal_empposter_detail.employeerefno %></td>
        <td><%= portal_empposter_detail.poster_refno %></td>
        <td><%= link_to 'Show', portal_empposter_detail %></td>
        <td><%= link_to 'Edit', edit_portal_empposter_detail_path(portal_empposter_detail) %></td>
        <td><%= link_to 'Destroy', portal_empposter_detail, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Portal Empposter Detail', new_portal_empposter_detail_path %>
