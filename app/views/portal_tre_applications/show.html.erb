<p id="notice"><%= notice %></p>

<!DOCTYPE html>
<html>
<head>
	<title></title>
</head>
<body>

<div class="container-fluid">
  <div class="row">
    <div class="col-sm-1" >      
    </div>

    <div class="col-sm-10" >
      <% session[:portal_tre_application_id] = @portal_tre_application.ID %>

      <div class="panel panel-default" id="panelframe" style="">
        <div class="panel-heading" id="panelheader" >
          <i class="fas fa-calendar-check"></i> <strong>TRE Application</strong>
        </div>

        <div class="panel-body">
           <div class="row">
            <div class="col-sm-4" >
               <div class="row">
                <div class="col-sm-12" >
                  <div class="row">
                    <div class="col-sm-6" >
                      <strong>ID: </strong> <%=  @portal_tre_application.ID %>
                    </div>

                    <div class="col-sm-6" >
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-sm-12" >
                	  <strong>Created Date: </strong><%= @portal_tre_application.DateFiled.strftime("%m/%d/%Y") %> 
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-sm-12" >
                	  <strong>Amount: </strong><%=  @portal_tre_application.Amount %>
                    </div>
                  </div>
                
                  <div class="row">
                    <div class="col-sm-12" >                    	
                      <strong>Created By: </strong><%= PisEmployeeU.where(EmployeeRefNo: @portal_tre_application.CreatedBy).pluck(:Description).to_sentence %></small>                         
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-sm-12" >                      
                      <strong>Status: </strong><%= GenFilingStatusF.where(FilingStatusRefNo: @portal_tre_application.FilingStatusRefNo ).pluck(:Description).to_sentence %>                         
                    </div>
                  </div>

                  <br>

                </div>
              </div>

              <div class="row">
                <div class="col-sm-12" >
                  <%= link_to 'Back to List', portal_tre_applications_path,  class:'btn btn-primary  btn-block'%>  
                  <br>
                  <br>
                  <br>                 
                </div> 
              </div>
            </div>

            <div class="col-sm-8"  style="border-left-style: dotted; border-color: #555555;">
              <iframe src="/portal_tre_application_details?tre_application_id=<%= @get_edit_id.to_param %>" style="border:none;" title="IframeExpenseDetails" height="430px" width="100%"></iframe>
            </div>
          </div>      
        </div>
      </div>      
    </div>

    <div class="col-sm-1" >      
    </div>
  </div>
</div>

<br>
<br>

</body>
</html>