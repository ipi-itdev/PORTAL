<!DOCTYPE html>
<html>
<head>
  <title></title>
</head>
<body>

<div class="container-fluid">
  <h1 align="center">Add New Article</h1>
  
  <div class="row">
    <div class="col-sm-2" style="background-color:lavender;"></div>
    <div class="col-sm-8" style="background-color:white;">

      <%= bootstrap_form_with(model: knowledgebasis, local: true) do |form| %>
        <% if knowledgebasis.errors.any? %>
          <div id="error_explanation">
            <h2><%= pluralize(knowledgebasis.errors.count, "error") %> prohibited this knowledgebasis from being saved:</h2>

            <ul>
            <% knowledgebasis.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
            </ul>
          </div>
        <% end %>

         <div class="field">
          <%= form.text_field :category %>
        </div>

         <div class="field">
          <%= form.text_field :title %>
        </div>

        
        <div class="field">
          <%= form.trix_editor :article%>
        </div>

        <br>

        <div class="actions">
          <%= form.submit %>
        </div>
      <% end %>

    </div>
    <div class="col-sm-2" style="background-color:lavender;">.col-sm-3</div>
  </div>
</div>
</body>
</html>
















