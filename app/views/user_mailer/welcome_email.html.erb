
<!DOCTYPE html>
<html>
<head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />



</head>
  <body >

    
          <p>Dear ECRG,</p>
          <br>
          <p>You have received new referral.</p>
          <% getreferername = PisEmployeeU.where(employeerefno: @referral.employeerefno).pluck(:Description).to_sentence %>
          <% getrefererempnum = PisEmployeeU.where(employeerefno: @referral.employeerefno).pluck(:EmployeeNumber).to_sentence%>
          <p>Referred by: <%= getreferername %> - <%= getrefererempnum %></p>

          <h3>Details:</h3>

          <table width="60%" style="border:1px solid #333">
          <tr style="border:1px solid #333">
          <td width="20%" style="border:1px solid #333"><strong>Name</strong></td>
          <td width="80%" align="left" style="border:1px solid #333"><%= @referral.name %></td>
          </tr>

          <tr style="border:1px solid #333">
          <td width="20%" style="border:1px solid #333"><strong>Contact No. / Email /<br>Social Media</strong></td>
          <td width="80%" align="left" style="border:1px solid #333"><%= @referral.contact %></td>
          </tr>

          <tr style="border:1px solid #333">
          <td width="20%" style="border:1px solid #333"><strong>Skills</strong></td>
          <td width="80%" align="left" style="border:1px solid #333"><%= @referral.skills %></td>
          </tr> 

          <tr style="border:1px solid #333">
          <td width="20%" style="border:1px solid #333"><strong>Remarks</strong></td>
          <td width="80%" align="left" style="border:1px solid #333"><%= @referral.remarks %></td>
          </tr> 
       
          </table>

          <hr>
          <p>This is a system generated email. Please do not reply.</p>
          <p>IPI Payslip Portal.</p>



  </body>
</html>