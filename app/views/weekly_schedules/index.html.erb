<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" type="text/css" href="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/css/jquery.dataTables.css">
</head>
<body>
<div class="container-fluid">  
  <div class="row">
    <div class="col-sm-2" >
    </div>

    <div class="col-sm-8" >
      <div class="panel panel-default" id="panelframe">
        <div class="panel-heading" id="panelheader">
          <div class="row">
            <div class="col-sm-11" >
              <strong><i class="fas fa-calendar-check"></i>Weekly Schedule Remarks</strong>
            </div>

            <% if mobile_device == "mobile" %>
              <br>
              <div class="col-sm-1" >
                <div class="btn-group">                  
                  <%= button_tag '<i class="fa fa-info-circle"></i>'.html_safe, method: 'post', class: "btn btn-primary", "data-toggle" => "tooltip", "data-placement" => "top", "title" => "User Manual", id: 'usermanual' %>
                </div>
              </div>
            <% else %>
              <div class="col-sm-1" >              
                <%= button_tag '<i class="fa fa-info-circle"></i>'.html_safe, method: 'post', class: "btn btn-primary btn-block btn-sm", "data-toggle" => "tooltip", "data-placement" => "top", "title" => "User Manual", id: 'usermanual' %>
              </div>    
            <% end %>
          </div>         
        </div>

        <div class="panel-body">
          <!--<p id="notice"><%= notice %></p>-->
          
          <div class="table table-responsive ">
            <table class="table" id="weekly_view_table" >
              <thead>
                <tr>
                  <th >ID</th>
                  <th >Employee Number</th>
                  <th >Employee Name</th>
                  <th >Job Position</th>
                  <th ></th>
                </tr>
              </thead>

              <tbody>

                <% @weekly_schedules.each do |weekly_view| %>
                  <tr>
                    <td ><%= weekly_view.ID %></td>
                    <td ><%= weekly_view.EmployeeNumber %></td>
                    <td ><%= weekly_view.Description %></td>
                    <td ><%= weekly_view.JobPosition %></td>
                    <td align="left">                      
                      <%= link_to '<i class="far fa-edit"></i>'.html_safe, edit_weekly_schedule_path(weekly_view.ID), class: "btn btn-primary" %>                    
                    </td>      
                  </tr>
                <% end %>
              </tbody>
            </table>

            <script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.8.2.min.js"></script>
            <script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/jquery.dataTables.min.js"></script>
            <script>
            $(function(){
              $("#weekly_view_table").dataTable();
            })
            </script>
          </div>   
        </div>        
      </div>
    </div>

    <div class="col-sm-2" >
    </div>
  </div>
</div>

<br>
<br>
<br>

<div id="myModal" class="modal">
  <!-- Modal content -->
  <div class="modal-content" style="width: 50%; position: absolute; left: 25%;">
    <span class="close">&times;</span>
    <iframe  src="\manuals\weeklyscheduleremarks.pdf"  style="border:none;" title="IframeExpenseDetails" height="500px" width="100%"> </iframe>
  </div>
</div>

<script>
  var modal = document.getElementById("myModal");
  var btn = document.getElementById("usermanual");
  var span = document.getElementsByClassName("close")[0];

  <% if mobile_device == "mobile" %>
    btn.onclick = function() {
      window.open("/manuals/weeklyscheduleremarks.pdf");
    }

  <% else %>
    btn.onclick = function() {
    modal.style.display = "block";
    }

    span.onclick = function() {
      modal.style.display = "none";
    }

    window.onclick = function(event) {
      if (event.target == modal) {
        modal.style.display = "none";
      }
    }
  <% end %>
</script>

</body>
</html>