<style type="text/css"> 
  #required_field {         
    position: absolute;
    bottom: px;
    left: 7px;
    font-size: 18px;
    color: red;
  }
</style>

<div class="container-fluid">
  <div class="row">
    <div class="col-sm-1" >    
    </div>

    <div class="col-sm-10" >
      <%= bootstrap_form_with(model: weekly_schedule, local: true) do |form| %>
        <% if weekly_schedule.errors.any? %>
          <div id="error_explanation">
            <ul>
              <% weekly_schedule.errors.full_messages.each do |message| %>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% session[:weekly_schedule_id] = @weekly_schedule.id %>

        <div class="panel panel-default" id="panelframe" style="">
          <div class="panel-heading" id="panelheader" >
            <i class="fas fa-calendar-check"></i> <strong>Weekly Schedule Remarks</strong>
          </div>

          <div class="panel-body">
            <div class="row">
              <div class="col-sm-4" >
                <div class="row">
                  <div class="col-sm-12" >
                  <small>
                    <div class="row">
                      <div class="col-sm-4" >
                        <strong>ID: </strong>
                      </div>

                      <div class="col-sm-8" >
                        <%=  @weekly_schedule.ID %>
                      </div> 
                    </div>

                    <br>

                    <div class="row">
                      <div class="col-sm-4" >
                        <strong>Employee: </strong>
                      </div>

                      <div class="col-sm-8" >
                        <%= PisEmployeeU.where(EmployeeRefNo: @weekly_schedule.EmployeeRefNo).pluck(:Description).to_sentence %>
                      </div> 
                    </div>

                    <div class="row">
                      <div class="col-sm-4" >
                        <strongJob Position: </strong>
                      </div>

                      <div class="col-sm-8" >
                        <%= @weekly_schedule.JobPosition %>
                      </div>                   
                    </div>
                  </small>
                  </div>
                </div>

                <div class="row">
                  <div class="col-sm-12" >

                    <br>                  
                    <br>
                    <%= link_to 'Back to List', weekly_schedules_path, class:'btn btn-primary  btn-block' %>
                  </div>
                </div>                
              </div>

              <% if mobile_device == "mobile" %>
                <div class="col-sm-8" >
              <% else %>
                <div class="col-sm-8"  style="border-left-style: dotted; border-color: #555555;" >
              <% end %>

                <iframe src="/weekly_schedule_details?weekly_id=<%= @get_edit_id.to_param %>" style="border:none;" title="IframeExpenseDetails" height="530px" width="100%"></iframe>
              </div>
            </div>
          </div>
        </div>
      <% end #  end of form%>     
    </div>

    <div class="col-sm-1" >      
    </div>
  </div>
</div>

<br>
<br>