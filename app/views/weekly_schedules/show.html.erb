<html>

<head>

      <!-- Required meta tags -->
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>

    <link href='https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-eOJMYsd53ii+scO/bJGFsiCZc+5NDVN2yr8+0RDqr0Ql0h+rP48ckxlpbzKgwra6' crossorigin='anonymous'>

    <script src='https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/js/bootstrap.bundle.min.js' integrity='sha384-JEW9xMcG8R+pH31jmWH6WWP0WintQrMb4s7ZOdauHnUtxwoG2vI5DkLtS3qm9Ekf' crossorigin='anonymous'></script>

  <style type='text/css'>
    @media screen and (min-width: 500px) {
      .mobile-menu {
        display: none !important;
      }
    }

    @media screen and (max-width: 600px) {
      .pc-menu {
        display: none !important;
      }
    }

    /* Styles go here */
    .page-header, .page-header-space {
      height: 150px;
    }

    .page-footer, .page-footer-space {
      height: 150px;
    }

    .page-footer {
      position: fixed;
      bottom: 0mm;
      width: 100%;
      /*border-top: 1px solid black;  for demo */
      background: white; /* for demo */
    }

    .page-header {
      position: fixed;
      top: 0mm;
      width: 100%;
    /* border-bottom: 1px solid black;  for demo */
      background: white; /* for demo */
    }

    .page {     
      page-break-after: always;
    }

    @page {
      margin: 20mm
    }

    @media print {
      thead {display: table-header-group;} 
      tfoot {display: table-footer-group;}
      thead {display: table-header-group;}
      @page {size: landscape}
        .noprint
        {
          display: none !important;
        }
      
      button {display: none;}      
      body {margin: 0;}
    }

    td {
      vertical-align: top;
    }

    #footer {
      border: 0px solid black;
      border-collapse: collapse;
    } 
  </style>
</head>

<div class="pc-menu">
<body>
  <div class='page-header' >
    <button type="button" onClick="window.print()" style="background: pink">
      SAVE
    </button>

    <% hashPisEmployeeU = PisEmployeeU.where(EmployeeRefNo: session[:weekly_schedule_employeerefno] ).pluck_to_hash(:EmployeeNumber,:Description)
      getPisEmployeeU = hashPisEmployeeU[0]  %>

    <% hashPisEmploymentInfoU = PisEmploymentInfoU.where(EmployeeRefNo: session[:weekly_schedule_employeerefno], IsActive: 1).pluck_to_hash(:ClientAccountRefNo, :PayFrequencyRefNo , :BasicRate, :EmployeeGroupRefNo, :JobPosition,:DepartmentRefNo, :PayrollRateRefNo, :JobPositionRefNo )%>  

    <% getPisEmploymentInfoU = hashPisEmploymentInfoU[0] %>

    <h4 align='center'>Information Professional Inc.</h4>
    <h5 align='center'>DTR Timesheet</h5>
    <table width="100%" style="border: 1px solid black;border-collapse: collapse;">
      <tbody>
        <tr style="border: 1px solid black;border-collapse: collapse;">
          <td width="15%" style="border: 1px solid black;border-collapse: collapse;"><small><b>NAME OF EMPLOYEE:</b></small></td>
          <td width="35%" style="border: 1px solid black;border-collapse: collapse;"><small><%= getPisEmployeeU[:Description] %></td>
          <td width="15%" style="border: 1px solid black;border-collapse: collapse;"><small><b>CLIENT/PROJ/DEPT:</b></small></td>
     
          <% if getPisEmploymentInfoU[:EmployeeGroupRefNo] == 1 #checkdepartment%>
            <td align="left" width="35%">
              <span >
               <small> <%= GenDepartmentM.where(DepartmentRefNo: getPisEmploymentInfoU[:DepartmentRefNo]).pluck(:Description).to_sentence%> </small>
              </span>
            </td>

          <% else %>     
            <td align="left" width="35%">
              <span ><%= GenClientAccountM.where(ClientAccountRefno: getPisEmploymentInfoU[:ClientAccountRefNo]).pluck(:Description).to_sentence %> 
                </span>
            </td>
          <% end %>  
        </tr>

        <tr>
          <td style="border: 1px solid black;border-collapse: collapse;"><small><b>DESIGNATION:</b></small></td>

          <% if getPisEmploymentInfoU[:EmployeeGroupRefNo] == 1 #check Department%>
            <td width="30%"> <%= @get_job_position_int %> </td>
          <% else %>
            <td width="30%"> <%= getPisEmploymentInfoU[:JobPosition] %> </td>
          <% end %>

          <td style="border: 1px solid black;border-collapse: collapse;"><small><b>PROJ. SUPERVISOR</b></small></td>
          <td style="border: 1px solid black;border-collapse: collapse;"><small><b></b></small></td>
        </tr>

      </tbody>
    </table>
  </div>

  <div class='page-footer'>

    <br>
  
    <table width="100%" id="footer">
      <tr id="footer">
        <td width="30%" id="footer"><small><b>PREPARED BY:</b></small></td>
        <td width="10%" align="center" id="footer"><b></b></td>
        <td width="30%" align="center" id="footer"><small><b><span style="border-bottom: 1px solid black; padding-left: 50px">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></b></small></td>
        <td width="30%" align="center" id="footer"><small><b>Date:</b><span style="border-bottom: 1px solid black; padding-left: 50px">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></small></td>
      </tr>

      <tr>
        <td width="30%" id="footer"><b></b></td>
        <td width="10%" align="center" id="footer"><small></small></td>
        <td width="30%" align="center" id="footer"><small><b>(Signature Over Printed Name)</b></small></td>
        <td width="30%"  id="footer"></td>
      </tr>

      <tr>
        <td width="30%" id="footer"><small><b>APPROVED BY IPI SUPERVISOR / TEAM LEAD:</b></small></td>
        <td width="10%" id="footer"><b></b></td>
        <td width="30%" id="footer" align="center"><small><b><span style="border-bottom: 1px solid black; padding-left: 50px">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></b></small></td>
        <td width="30%"id="footer" align="center"><small><b>Date:</b><span style="border-bottom: 1px solid black; padding-left: 50px">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></small></td>
      </tr>

      <tr>
        <td width="30%" id="footer"><small><b>RECEIVED BY (For Billing Purposes):</b></small></td>
        <td width="10%" align="center" id="footer"><b></b></td>
        <td width="30%" id="footer" align="center"><small><b><span style="border-bottom: 1px solid black; padding-left: 50px">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></b></small></td>
        <td width="30%" id="footer" align="center"><small><b>Date:</b><span style="border-bottom: 1px solid black; padding-left: 50px">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></small></td>
      </tr>
    </table>
  </div>

  <table width="100%">
    <thead>
      <tr>
        <td>
          <!--place holder for the fixed-position header-->
          <div class='page-header-space'></div>
        </td>
      </tr>
    </thead>

      <tr>
        <td>
          <!--*** CONTENT GOES HERE ***-->
          <div class='page'>
            <% get_emp_dhs = DtrApprove.where(EmployeeRefNo: session[:weekly_schedule_employeerefno], WorkDate: session[:WorkDateFrom_session]..session[:WorkDateTo_session] ) %>
              
              <table style="border: 1px solid black;border-collapse: collapse;" width="100%" >
                 <thead>
                    <tr>
                        <th width="10%" style="text-align:center; border: 1px solid black;border-collapse: collapse;"><small><b>Work Date</b></small></th>
                        <th width="400px" style="text-align:center; border: 1px solid black;border-collapse: collapse;"><small><b>Tasks Performed</b></small></th>
                        <th width="100px" style="text-align:center; border: 1px solid black;border-collapse: collapse;"><small><b>Status</b></small></th>
                        <th width="150px" style="text-align:center; border: 1px solid black;border-collapse: collapse;"><small><b>Time-In</b></small></th>
                        <th width="150px" style="text-align:center; border: 1px solid black;border-collapse: collapse;"><small><b>Time-Out</b></small></th>
                        <th width="400px" style="text-align:center; border: 1px solid black;border-collapse: collapse;"><small><b>Remarks</b></small></th>
                    </tr>
                </thead>
                <% get_emp_dhs.each do |get_emp_dhs| %>
                <tr>
                  <td style="border: 1px solid black;border-collapse: collapse;" width="50">
                   <small><%= get_emp_dhs.WorkDate.to_date.strftime("%m/%d/%Y") %></small>
                  </td>
                  <td style="border: 1px solid black;border-collapse: collapse;" width="150">
                   <small> <%= simple_format(get_emp_dhs.task)%> </small>
                  </td> 
                  <td style="border: 1px solid black;border-collapse: collapse;" width="10">
                      <center><small><%= get_emp_dhs.DayStatus %></center>
                  </td>
                  <td style="border: 1px solid black;border-collapse: collapse;" width="10">
                    <% if get_emp_dhs.time_in.blank? == false%>
                      <center><small><%= get_emp_dhs.time_in.to_datetime.strftime("%H:%M") %></small></center>
                    <% end %>
                  </td>
                  <td style="border: 1px solid black;border-collapse: collapse;" width="10">
                    <% if get_emp_dhs.time_out.blank? == false%>
                      <center><small><%= get_emp_dhs.time_out.to_datetime.strftime("%H:%M") %></small></center>
                    <% end %>
                  </td>
                  <td style="border: 1px solid black;border-collapse: collapse;" width="80">
                      <small><%= get_emp_dhs.Remarks %>
                  </td>
                </tr>
                 <% end %>  
              </table>             
          </div>
           <!--*** endCONTENT GOES HERE ***-->
        </td>
      </tr>

    <tfoot>
      <tr>
        <td>
          <!--place holder for the fixed-position footer-->
          <div class='page-footer-space'></div>
        </td>
      </tr>
    </tfoot>
  </table>
</body>
</div>

<div class="mobile-menu">
    <a  onClick="window.print()">Content is too large, Click Here to View </a>
</div>
</html> 