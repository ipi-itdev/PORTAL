<%= stylesheet_link_tag 'leave_credits'%>



<div class="container">

 <div class="row">
    <div class="col-sm-1" >
      
    </div>
    <div class="col-sm-10" >

		<div class="panel panel-default" id="panelframe">
		<div class="panel-heading" id="panelheader"><strong><i class="fas fa-calendar-check"></i>Leave Credits</strong></div>
		  <div class="panel-body">



				<button class="tablink" onclick="openPage('Home', this)" id="defaultOpen"></button>
				<% if current_user.is_manager ==  true%>
						<button class="tablink" onclick="openPage('News', this, '#f1ba2e')" ><b>Dept Leave Credits</b></button>
				<% end %>
			
				<!---<button class="tablink" onclick="openPage('Contact', this, 'orange')">Contact</button> -->
				<!---<button class="tablink" onclick="openPage('About', this, 'orange')">About</button> --->

				<div id="Home" class="tabcontent">
				  
						 	<table class="table">
							    <thead>
							      <tr>
							        <th >Leave Type</th>
							        <th align="center">Total Leave Available</th>
							        <th>Used Leave</th>
							      </tr>
							    </thead>
							    <tbody>

							      <% @getleavetype.each do |getleavetype|%>
							      <tr>
							        <td>

							        	<%= getleavetype.LeaveType %>

							        </td>			        
						
							        <td >
							        	<% getleaveavail1 = getleavetype.LeaveAvailables.to_f %>
										<%=  getleaveavail1.to_s(:currency).gsub("$",'')%> day/s
							        </td>

							        <td align="left">
							        		
							     

										<a href="#" data-toggle="modal" data-target="#exampleModal-<%= getleavetype.LeaveTypeRefNo %>" class="btn btn-primary btn-sm">
										    <i class="far fa-file"></i>View
										</a>


										<!-- start Modal -->
										<div class="modal fade" id="exampleModal-<%= getleavetype.LeaveTypeRefNo%>" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
										  <div class="modal-dialog" role="document">
										    <div class="modal-content">
										      <div class="modal-header">
										        <strong class="modal-title" id="exampleModalLabel">Used Leaves - <%= getleavetype.LeaveType %> </strong>
										        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
										          <span aria-hidden="true">&times;</span>
										        </button>
										      </div>
										      <div class="modal-body">

						      					<table width="100%" class="table table-bordered">
						                            <tr>
						                              <small>
						                              <td width="20%" align="left"><b><strong>Date Filed</strong></b></td>
						                              <td width="5%" align="left"><b><strong>Hrs.</strong></b></td>
						                              <td width="30%" align="left"><b><strong>Reason</strong></b></td>
						                              </small>  
						                            </tr>
						              
						                            
						                            <% getleaves = TmsLeaveApplicationU.where(EmployeeRefNo: current_user.EmployeeRefNo, LeaveTypeRefNo: getleavetype.LeaveTypeRefNo, FilingStatusRefNo: 4 ) #start inner loop%>
						                            <% getleaves.each do |type2|%>

						                            <tr>
						                              <td width="20%" align="center"><small>
						                                <%  getworkdate1 = type2.WorkDate %>
						                                <%= getworkdate1.to_date.strftime("%m/%d/%Y") %>
						                                </small>
						                              </td>
						                              <td width="5%" align="left"><small><%= type2.Hours %></small></td>
						                              <td width="30%" align="left"><small><%= type2.Reason %></small></td>  
						                            </tr>                                  
						                    		<% end #END OF INNER LOOP%>
								                </table>

										      </div>
										      <div class="modal-footer">
										        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
										      </div>
										    </div>
										  </div>
										</div>
										<!-- end Modal -->

							        </td>

							      </tr>

							      <% end %>

							    </tbody>

							</table>

				</div>

				<div id="News" class="tabcontent">
				
				<% if current_user.is_manager ==  true %>

				<% @get_manager_departments.each do |get_manager_departments|%>

				<div class="panel panel-default" >
				  <div class="panel-heading">
				  	<a data-toggle="collapse" href="#collapse1-<%= get_manager_departments.DepartmentRefNo %>" id="leavelabel"><%= get_manager_departments.Description %></a>
				  </div>

				  <div id="collapse1-<%= get_manager_departments.DepartmentRefNo %>" class="panel-collapse collapse">
				  <div class="panel-body">

						<% get_all_emp_underdep = PisEmploymentInfoU.where(DepartmentRefNo: get_manager_departments.DepartmentRefNo, IsActive: 1)%>
						

							  <table class="table">
							    <thead>
							      <tr>
							        <th>Employee Name</th>
							        <th >Employee Number</th>
							        <th>Leave Credits</th>
							      </tr>
							    </thead>
							    <tbody>
							    <% get_all_emp_underdep.each do |get_all_emp_underdep|%>
							      <tr>
							        <td>
							        	<%  hash_get_emp_details = PisEmployeeU.where(EmployeeRefNo: get_all_emp_underdep.EmployeeRefNo).pluck_to_hash(:Description, :EmployeeNumber) %>
							        	<% get_emp_details = hash_get_emp_details[0]%>
							        	<%= get_emp_details[:Description]%>
							        </td>
							        <td>
							        	<%= get_emp_details[:EmployeeNumber] %>
							        </td>
									<td>
							        	<% get_emp_details[:EmployeeNumber] %>
										<a href="#" data-toggle="modal" data-target="#exampleModal-<%= get_all_emp_underdep.EmployeeRefNo %>" class="btn btn-primary btn-sm">
										    <i class="far fa-file"></i>View
										</a>

										<!-- start Modal -->
										<div class="modal fade" id="exampleModal-<%= get_all_emp_underdep.EmployeeRefNo%>" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
										  <div class="modal-dialog" role="document">
										    <div class="modal-content">
										      <div class="modal-header">
										        <strong class="modal-title" id="exampleModalLabel">Leave Credits - <%= PisEmployeeU.where(EmployeeRefNo: get_all_emp_underdep.EmployeeRefNo).pluck(:Description).to_sentence %></strong>
										        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
										          <span aria-hidden="true">&times;</span>
										        </button>
										      </div>
										      <div class="modal-body">
												<div class="panel panel-default">
												  <div class="panel-body">

											  		  <div class="row">
													    <div class="col-sm-4" >
													      <STRONG>Leave Type</STRONG>
													    </div>
													    <div class="col-sm-4" >
													      <STRONG>Total Leaves Available</STRONG>
													    </div>
														<div class="col-sm-4"  align="center">
													      <STRONG>Used Leaves</STRONG>
													    </div>

													  </div>
												  </div>
												</div>

										      		<% getleavetype = ViewLeaveDetailsPortal.where(EmployeeRefNo: get_all_emp_underdep.EmployeeRefNo ) #start outer loop %>
										      		<% getleavetype.each do |getleavetype_details| %>



												  <div class="panel-group">
												    <div class="panel panel-default">
			
												      <div class="panel-heading">
												      	  <div class="row">
														    <div class="col-sm-4" >

	      												        <h4 class="panel-title">
														          <a data-toggle="collapse" href="#collapse2-<%= getleavetype_details.LeaveTypeRefNo%>-<%= getleavetype_details.EmployeeRefNo %>" id="leavelabel"> <%= getleavetype_details.LeaveType%></a>
														        </h4>

														    </div>

														    <div class="col-sm-4" align="center">
									      			        	<% getleaveavail1 = getleavetype_details.LeaveAvailables.to_f %>
																<%=  getleaveavail1.to_s(:currency).gsub("$",'')%> day/s
														    </div>

														    <div class="col-sm-4" align="center">
												
														          <a data-toggle="collapse" href="#collapse2-<%= getleavetype_details.LeaveTypeRefNo%>-<%= getleavetype_details.EmployeeRefNo %>" id="leavelabel"> View </a>
							
														    </div>

														  </div>

												      </div>

												      <div id="collapse2-<%= getleavetype_details.LeaveTypeRefNo%>-<%= getleavetype_details.EmployeeRefNo %>" class="panel-collapse collapse">
												        <div class="panel-body">


												        	   <table width="100%" class="table table-bordered">
										                                    <tr>
										                                      <small>
										                                      <td width="20%" align="left"><b><strong>Date Filed</strong></b></td>
										                                      <td width="5%" align="left"><b><strong>Hrs.</strong></b></td>
										                                      <td width="30%" align="left"><b><strong>Reason</strong></b></td>
										                                      </small>  
										                                    </tr> 

										                                    <% getleaves = TmsLeaveApplicationU.where(EmployeeRefNo: get_all_emp_underdep.EmployeeRefNo, LeaveTypeRefNo: getleavetype_details.LeaveTypeRefNo, FilingStatusRefNo: 4 ) #start inner loop%>
										                                    <% getleaves.each do |type2|%>

										                                    <tr>
										                                      <td width="20%" align="left"><b><small>
										                                        <%  getworkdate1 = type2.WorkDate %>
										                                        <%= getworkdate1.to_date.strftime("%m/%d/%Y") %>
										                                        </small></b>
										                                      </td>
										                                      <td width="5%" align="left"><b><small><%= type2.Hours %></small></b></td>
										                                      <td width="30%" align="left"><b><small><%= type2.Reason %></small></b></td>  
										                                    </tr>                                  
										                            <% end #END OF INNER LOOP%>
										                        </table>

												        </div>
									
												      </div>
												    </div>
												  </div>

												  <% end %>

										      </div>
										      <div class="modal-footer">
										        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
										      </div>
										    </div>
										  </div>
										</div>
										<!-- end Modal -->
							        </td>
							        
							      </tr>
								<% end %>
							    </tbody>
							  </table>
						
				  </div>
				  </div>
				</div>

				<% end %>
				<% end %>

				</div>

				<div id="Contact" class="tabcontent">
				  <h3>Contact</h3>
				  <p>Get in touch, or swing by for a cup of coffee.</p>
				</div>

				<div id="About" class="tabcontent">
				  <h3>About</h3>
				  <p>Who we are and what we do.</p>
				</div>


		  </div>
		  <div class="panel-footer"></div>
		</div>

    </div>
    <div class="col-sm-1" >
   
    </div>
</div>


</div>
<!-- end container -->


<script>
function openPage(pageName,elmnt,color) {
  var i, tabcontent, tablinks;
  tabcontent = document.getElementsByClassName("tabcontent");
  for (i = 0; i < tabcontent.length; i++) {
    tabcontent[i].style.display = "none";
  }
  tablinks = document.getElementsByClassName("tablink");
  for (i = 0; i < tablinks.length; i++) {
    tablinks[i].style.backgroundColor = "";
  }
  document.getElementById(pageName).style.display = "block";
  elmnt.style.backgroundColor = color;
}

// Get the element with id="defaultOpen" and click on it
document.getElementById("defaultOpen").click();
</script>
