<%= stylesheet_link_tag 'leave_credits'%>



<div class="container">

 <div class="row">
    <div class="col-sm-1" >
      
    </div>
    <div class="col-sm-10" >

		<div class="panel panel-default" id="panelframe">
		<div class="panel-heading" id="panelheader">

			 <div class="row">
    			<div class="col-sm-8" >
    				<strong><i class="fas fa-calendar-check"></i>Leave Credits</strong>
    			</div>    			

				<% if mobile_device == "mobile" %>
					<br>

					<div class="col-sm-3" >
						<%= link_to '<i class="fa fa-plus" aria-hidden="true"></i>File Leave Application'.html_safe, create_leave_path, method: 'post', class:'btn btn-primary btn-block btn-sm' %>
					</div> 

					<div class="col-sm-1" >              
						<%= button_tag '<i class="fa fa-info-circle"></i>'.html_safe, method: 'post', class: "btn btn-primary btn-block btn-sm", "data-toggle" => "tooltip", "data-placement" => "top", "title" => "User Manual", id: 'usermanual' %>
					</div>  

				<% else %>
					<div class="col-sm-3" >
						<%= link_to '<i class="fa fa-plus" aria-hidden="true"></i>File Leave Application'.html_safe, create_leave_path, method: 'post', class:'btn btn-primary btn-block btn-sm' %>
					</div> 

					<div class="col-sm-1" >              
						<%= button_tag '<i class="fa fa-info-circle"></i>'.html_safe, method: 'post', class: "btn btn-primary btn-block btn-sm", "data-toggle" => "tooltip", "data-placement" => "top", "title" => "User Manual", id: 'usermanual' %>
					</div>    
				<% end %>
    		</div>
		</div>
		
		  <div class="panel-body">
				<button class="tablink" onclick="openPage('Home', this, '#f1ba2e')" id="defaultOpen" style="display: none;"><b>My Leave Credits</b></button>
			
				<div id="Home" class="tabcontent">				  
					<table class="table">
					    <thead>
					      <tr>
					        <th >Leave Type</th>
					        <th align="center">Total Leave Available</th>
					        <th align="center">Leave Applied</th>
					        <th>Used Leave</th>
					      </tr>
					    </thead>
					    
						<tbody>
					      	<% @getleavetype.each do |getleavetype|%>
					      		<tr>
					        		<td>
					        			<%= getleavetype.LeaveType %>
					        		</td>			        

					        		<td >
					        			<% getleaveavail1 = getleavetype.LeaveAvailables.to_f %>
												<%=  getleaveavail1.to_s(:currency).gsub("$",'')%> day/s
					        		</td>


							        <td>
							        	<% getleavetype1 =getleavetype.LeaveApplied.to_f %> 
							        	<%=  getleavetype1.to_s(:currency).gsub("$",'')%> day/s
							        </td>

					        		<td align="left">					        							     
										<a href="#" data-toggle="modal" data-target="#exampleModal-<%= getleavetype.LeaveTypeRefNo %>" class="btn btn-primary btn-sm">
										    <i class="far fa-file"></i>View
										</a>

										<!-- start Modal -->
										<div class="modal fade" id="exampleModal-<%= getleavetype.LeaveTypeRefNo%>" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
											<div class="modal-dialog" role="document">
										    	<div class="modal-content">
										      		<div class="modal-header">
										        		<strong class="modal-title" id="exampleModalLabel">Used Leaves - <%= getleavetype.LeaveType %> </strong>
										        		<button type="button" class="close" data-dismiss="modal" aria-label="Close">
										          			<span aria-hidden="true">&times;</span>
										        		</button>
										      		</div>

													<div class="modal-body">
					  									<table width="100%" class="table table-bordered">
					        		                		<tr>
					        		                  			<small>
					        		                  				<td width="20%" align="left"><b><strong>Date Filed</strong></b></td>
					        		                  				<td width="5%" align="left"><b><strong>Hrs.</strong></b></td>
					        		                  				<td width="30%" align="left"><b><strong>Reason</strong></b></td>
					        		                  			</small>  
					        		                		</tr>

					        		                		<% getleaves = TmsLeaveApplicationU.where(EmployeeRefNo: current_user.EmployeeRefNo, LeaveTypeRefNo: getleavetype.LeaveTypeRefNo, FilingStatusRefNo: 4 ) #start inner loop%>
					        		                		<% getleaves.each do |type2|%>
					        		                			<tr>
					        		                  				<td width="20%" align="center">
																		<small>
					        		                    					<%  getworkdate1 = type2.WorkDate %>
					        		                    					<%= getworkdate1.to_date.strftime("%m/%d/%Y") %>
					        		                    				</small>
					        		                  				</td>
					        		                  				<td width="5%" align="left"><small><%= type2.Hours %></small></td>
					        		                  				<td width="30%" align="left"><small><%= type2.Reason %></small></td>  
					        		                			</tr>                                  
					        		        				<% end %>
						    		            		</table>
										      		</div>
															
										      		<div class="modal-footer">
										        		<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
										      		</div>
										    	</div>
										  	</div>
										</div>
										<!-- end Modal -->
					        		</td>
					    		</tr>
					    	<% end %>
						</tbody>
					</table>
				</div>

				<div id="Contact" class="tabcontent">
					<h3>Contact</h3>
					<p>Get in touch, or swing by for a cup of coffee.</p>
				</div>

				<div id="About" class="tabcontent">
					<h3>About</h3>
				  	<p>Who we are and what we do.</p>
				</div>
		  	</div>

		  	<div class="panel-footer">
			</div>
		</div>

    </div>

    <div class="col-sm-1" >   
    </div>
</div>


</div>
<!-- end container -->


<script>
function openPage(pageName,elmnt,color) {
  var i, tabcontent, tablinks;
  tabcontent = document.getElementsByClassName("tabcontent");
  for (i = 0; i < tabcontent.length; i++) {
    tabcontent[i].style.display = "none";
  }
  tablinks = document.getElementsByClassName("tablink");
  for (i = 0; i < tablinks.length; i++) {
    tablinks[i].style.backgroundColor = "";
  }
  document.getElementById(pageName).style.display = "block";
  elmnt.style.backgroundColor = color;
}

// Get the element with id="defaultOpen" and click on it
document.getElementById("defaultOpen").click();
</script>

<div id="myModal" class="modal">
  <!-- Modal content -->
  <div class="modal-content" style="width: 50%; position: absolute; left: 25%;">
    <span class="close">&times;</span>
    <iframe  src="\manuals\leavecredits.pdf"  style="border:none;" title="IframeExpenseDetails" height="500px" width="100%"> </iframe>
  </div>
</div>

<script>
  var modal = document.getElementById("myModal");
  var btn = document.getElementById("usermanual");
  var span = document.getElementsByClassName("close")[0];

  <% if mobile_device == "mobile" %>
    btn.onclick = function() {
      window.open("/manuals/leavecredits.pdf");
    }

  <% else %>
    btn.onclick = function() {
    modal.style.display = "block";
    }

    span.onclick = function() {
      modal.style.display = "none";
    }

    window.onclick = function(event) {
      if (event.target == modal) {
        modal.style.display = "none";
      }
    }
  <% end %>
</script>

<br>
<br>