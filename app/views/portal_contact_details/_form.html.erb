<script type="text/javascript">
  $('#showNext').click(function(){ 
      if($('#divEmergency').css('display') == 'block')
      { 
        var reg = /^([A-Za-z0-9_\-\.])+\@([A-Za-z0-9_\-\.])+\.([A-Za-z]{2,4})$/;
        if(document.getElementById("portal_contact_detail_EmergencyName1").value.length == 0 || document.getElementById("portal_contact_detail_EmergencyName2").value.length == 0 ) 
        {
          document.getElementById("showPrev").click();
          alert('Please enter Primary / Secondary Contact Person Name');
        }
        else if (document.getElementById("portal_contact_detail_EmergencyRelationship1").value.length == 0 || document.getElementById("portal_contact_detail_EmergencyRelationship2").value.length == 0)
        {
          document.getElementById("showPrev").click();
          alert('Please enter Primary/Secondary Contact Relationship');
        } 
        else if (document.getElementById("portal_contact_detail_EmergencyContactNo1").value.length == 0 || document.getElementById("portal_contact_detail_EmergencyContactNo2").value.length == 0) 
        {
          document.getElementById("showPrev").click();
          alert('Please enter Primary / Secondary Mobile No.');
        }
        else if (document.getElementById("portal_contact_detail_EmergencyAddress1").value.length == 0 || document.getElementById("portal_contact_detail_EmergencyAddress2").value.length == 0) 
        {
          document.getElementById("showPrev").click();
          alert('Please enter Primary / Secondary Address.');
        }
        else if (document.getElementById("portal_contact_detail_EmergencyEmail1").value.length != 0 && reg.test(portal_contact_detail_EmergencyEmail1.value) == false) 
        {
          document.getElementById("showPrev").click();
          alert('Invalid Primary Contact Person Email Address');
        }
        else if (document.getElementById("portal_contact_detail_EmergencyEmail2").value.length != 0 && reg.test(portal_contact_detail_EmergencyEmail2.value) == false) 
        {
          document.getElementById("showPrev").click();
          alert('Invalid Secondary Contact Person Email Address');
        }
        else if (document.getElementById("portal_contact_detail_EmergencyContactNo1").value == document.getElementById("portal_contact_detail_EmergencyContactNo2").value ) 
        {
          document.getElementById("showPrev").click();
          alert('Primary & Secondary Contact Person Primary Mobile No. must be different');
        }

      }
      else if ($('#divContact').css('display') == 'block') 
      {
        var reg = /^([A-Za-z0-9_\-\.])+\@([A-Za-z0-9_\-\.])+\.([A-Za-z]{2,4})$/;
        if(document.getElementById("portal_contact_detail_MobileNumber").value.length == 0 || document.getElementById("portal_contact_detail_PersonalEmailAddress").value.length == 0 ) 
        {
          document.getElementById("showPrev").click();
          alert('Primary Mobile / Email is required');
        }

        else if (reg.test(portal_contact_detail_PersonalEmailAddress.value) == false) 
        {
          document.getElementById("showPrev").click();
          alert('Invalid Primary Email Address');
        }
        else if (document.getElementById("portal_contact_detail_WorkEmailAddress").value.length != 0 && reg.test(portal_contact_detail_WorkEmailAddress.value) == false) 
        {
          document.getElementById("showPrev").click();
          alert('Invalid Secondary Email Address');
        }
        else if (document.getElementById("portal_contact_detail_MobileNumber").value.length != 0 && document.getElementById("portal_contact_detail_MobileNumber").value.length != 11) 
        {
          document.getElementById("showPrev").click();
          alert('Invalid Primary Mobile No, must be 11 characters');
        }
        else if (document.getElementById("portal_contact_detail_MobileNumber2").value.length != 0 && document.getElementById("portal_contact_detail_MobileNumber2").value.length != 11)
        {
          document.getElementById("showPrev").click();
          alert('Invalid Secondary Mobile No, must be 11 characters');
        }
        else if (document.getElementById("portal_contact_detail_MobileNumber").value == document.getElementById("portal_contact_detail_MobileNumber2").value) 
        {
          document.getElementById("showPrev").click();
          alert('Primary & Secondary Mobile No. must be different');
        }
        else if (document.getElementById("portal_contact_detail_PersonalEmailAddress").value == document.getElementById("portal_contact_detail_WorkEmailAddress").value)
        {
          document.getElementById("showPrev").click();
          alert('Primary & Secondary Email must be different');
        } 

      }
      else if ($('#divAddress').css('display') == 'block') 
      {
        var checkBox = document.getElementById("portal_contact_detail_IsSame");
        if ($("#portal_contact_detail_PermanentRegionRefNo").val() == 0 || $("#portal_contact_detail_PermanentProvinceRefNo").val() == 0 || $("#portal_contact_detail_PermanentMunicipalityRefNo").val() == 0 || $("#portal_contact_detail_PermanentBrgyRefNo").val() == 0 || document.getElementById("portal_contact_detail_PermanentAddress").value.length == 0 ) 
        {
          document.getElementById("showPrev").click();
          alert('Please check required field(s)');
        }
        else if (checkBox.checked != true && $("#portal_contact_detail_PresentRegionRefNo").val() == 0) 
        {
          document.getElementById("showPrev").click();
          alert('Please check required field(s)');
        }
        else if (checkBox.checked != true && $("#portal_contact_detail_PresentProvinceRefNo").val() == 0) 
        {
          document.getElementById("showPrev").click();
          alert('Please check required field(s)');
        }
        else if (checkBox.checked != true && $("#portal_contact_detail_PresentMunicipalityRefNo").val() == 0) 
        {
          document.getElementById("showPrev").click();
          alert('Please check required field(s)');
        }
        else if (checkBox.checked != true && $("#portal_contact_detail_PresentBrgyRefNo").val() == 0) 
        {
          document.getElementById("showPrev").click();
          alert('Please check required field(s)');
        }
        else if (checkBox.checked != true && document.getElementById("portal_contact_detail_PresentAddress").value.length == 0 ) 
        {
          document.getElementById("showPrev").click();
          alert('Please check required field(s)');
        }       

      }
      else if ($('#divPersonal').css('display') == 'block')
      {
        if ($("#portal_contact_detail_CivilStatusRefNo").val() == 0) 
        {
          document.getElementById("showPrev").click();
          alert('Please select a civil status');
        }
      } 


  });

</script> 
