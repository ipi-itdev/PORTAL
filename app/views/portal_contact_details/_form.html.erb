    function loadChild(type, refNo, field, childId) {
      $.ajax({
        url: 'https://api.ipiphil.com/api/cronus/ddaddress?type='+ type + '&referenceValue=' + refNo,
        type: "GET",
        headers: { "x-api-key": "14D7F4F394ECBC8B70BFDCDFFE2A93B3" },
        contentType: 'application/json; charset=utf-8',
        async: false,
        success: function(data) {
          field.empty()

          for (var i =0; i < data.length; i++) {
            var opt = $('<option/>')

            opt.attr('value', data[i].RefNo)
            opt.text(data[i].Description)
            opt.appendTo(field)              
          }

          field.val(childId)
        }
      })
    }
            
