<!DOCTYPE html>
<html>
<head>

  <link rel="stylesheet" type="text/css" href="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/css/jquery.dataTables.css">

</head>
<body>

<div class="container-fluid">
  
  <div class="row">
    <div class="col-sm-2" >

    </div>
    <div class="col-sm-8" >

      <div class="panel panel-default" id="panelframe">
        <div class="panel-heading" id="panelheader">
          <div class="row">
            <div class="col-sm-9" >
              <strong><i class="fas fa-calendar-check"></i>Change Request</strong>
            </div>

            <div class="col-sm-3" >
              <%= link_to '<i class="fa fa-plus" aria-hidden="true"></i>File Request'.html_safe, create_changerequest_path, method: 'post', class:'btn btn-primary btn-block btn-sm' %>
            </div>
          </div>

         
        </div>
        <div class="panel-body">

          <!--<p id="notice"><%= notice %></p>-->
          <div class="table table-responsive ">
          <table class="table" id="portal_leave_view_table" >
            <thead>
              <tr>
                <th >ID</th>  
                <th >Created Date</th>    
                <th >Status</th>   
                <th ></th>
              </tr>
            </thead>

            <tbody>

              <% @portal_change_requests.each do |portal_leave_view| %>
                <tr>
                  <td ><%= portal_leave_view.ID %></td>
                  <td ><%= portal_leave_view.CreatedDate.strftime("%m/%d/%Y") %></td>
                  <td ><%= GenFilingStatusF.where(FilingStatusRefNo: portal_leave_view.FilingStatusRefNo).pluck(:Description).to_sentence  %> </td>
                  <td align="left">

                    <% if portal_leave_view.FilingStatusRefNo.to_i == 1 %>
                      <div class="btn-group btn-group-sm btn-group-block">
                        <%= link_to '<i class="far fa-paper-plane"></i>'.html_safe, post_changerequest_path(changerequest_id: portal_leave_view.ID), method: 'post',  class: "btn btn-primary", data: { confirm: 'Are you sure you want to request this application?', disable_with: "<i class='fa fa-spinner fa-spin'></i>" } %>
                        <%= link_to '<i class="far fa-edit"></i>'.html_safe, edit_portal_change_request_path(portal_leave_view ),  class: "btn btn-primary" %>
                        <%= link_to '<i class="far fa-trash-alt"></i>'.html_safe, portal_leave_view, method: :delete, data: { confirm: 'Are you sure you want to cancel this application?', disable_with: "<i class='fa fa-spinner fa-spin'></i>" },  class: "btn btn-primary" %>    
                      </div>

                    <% elsif portal_leave_view.FilingStatusRefNo.to_i == 40 || portal_leave_view.FilingStatusRefNo.to_i == 2 %>
                      <div class="btn-group btn-group-sm btn-group-block">
                        <%= link_to '<i class="far fa-edit"></i>'.html_safe, edit_portal_change_request_path(portal_leave_view ),  class: "btn btn-primary" %>
                        <%= link_to '<i class="far fa-trash-alt"></i>'.html_safe, portal_leave_view, method: :delete, data: { confirm: 'Are you sure you want to cancel this application?', disable_with: "<i class='fa fa-spinner fa-spin'></i>" },  class: "btn btn-primary" %>    
                      </div>

                    <% else %>
                        <%= link_to 'View', "/portal_change_requests/#{portal_leave_view.ID}?frmtre_ex=test", class: "btn btn-primary btn-sm " %>

                    <% end %> 

                  </td>
      
                </tr>
              <% end %>
            </tbody>
          </table>


          <script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.8.2.min.js"></script>
          <script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/jquery.dataTables.min.js"></script>
          <script>
          $(function(){
            $("#portal_leave_view_table").dataTable();
          })
          </script>

          </div>   

        </div>
        
      </div>

    </div>
    <div class="col-sm-2" >

    </div>
  </div>
</div>

<br>
<br>
<br>

</body>
</html>