<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>

  <style type="text/css">
    #required_field {
      position: absolute;
      bottom: px;
      left: 7px;
      font-size: 18px;
      color: red;
    }
  </style>
</head>

<body>
  <div class="container-fluid">
    <%= bootstrap_form_with(model: portal_dependent, local: true) do |form| %>
      <% if portal_dependent.errors.any? %>
        <div id="error_explanation">
          <ul>
            <p style="color: red;font-size: 80%;">
              <% portal_dependent.errors.full_messages.each do |message| %>
                <%= message %> <br>
              <% end %>
            </p>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-sm-6" >        
          <%= form.hidden_field :EmployeeRefNo, value: current_user.EmployeeRefNo %>         
          
          <p id="required_field"> *</p>                  
          <small><%= form.text_area :Description, label: 'Name', class: 'form-control input-sm', style: 'resize: none;' %></small>                          
        </div> 

        <div class="col-sm-6">
          <%= form.check_box :IsPWD, label: 'Is PWD?' %>
        </div>       
      </div>

      <div class="row">
        <div class="col-sm-6" >
          <p id="required_field"> *</p>
          <small><%= form.text_field :Relationship, label: 'Relationship', class: 'form-control input-sm', style: 'resize: none;' %></small>                          
        </div>

        <div class="col-sm-6" >
          <p id="required_field"> *</p>
          <small><%= form.date_field :BirthDate, label: 'Birth Date', min: '1900-01-01', max: '2030-01-01' %></small>         
        </div>        
      </div>      

      <div class="row">
        <div class="col-sm-12" >
        </div>
      </div>

      <br>
      <br>  

      <div class="row">
        <div class="col-sm-6" >
        </div>

        <div class="col-sm-6" >
          <div class="row">
            <div class="col-sm-6" >
              <%= form.submit 'Save', class:'btn btn-success btn-sm btn-block', id: 'submit_detail_but' %>
            </div>

            <script type="text/javascript">
              $(document).submit(function() {
                $( "#submit_detail_but" ).prop('disabled', true);
              });                      
            </script>

            <div class="col-sm-6" >
              <%= link_to 'Back to List', portal_dependents_path, class:'btn btn-primary btn-sm btn-block' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</body>
</html>

