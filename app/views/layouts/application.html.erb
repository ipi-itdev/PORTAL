  <!DOCTYPE html>
<html>
<head>
    <title>PITS Employee Portal</title>
    <%= csrf_meta_tags %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.2/css/all.css" integrity="sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr" crossorigin="anonymous">
    <link href='https://fonts.googleapis.com/css?family=Wendy+One' rel='stylesheet' type='text/css'>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.2/jquery.min.js"></script>


    <script src="https://cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js"></script>
    <script src="//cdn.ckeditor.com/4.11.3/full/ckeditor.js"></script>
  
</head>

<body id="overscrollbody">

  
<div id="mainmove">
    <% if notice.blank?%>  
      <div id="hide">
      </div>
    <% else %>
      <div id = class="alert" role="alert">
      <span class="closebtn" onclick="this.parentElement.style.display='none';">&times;</span> 
      <p class="alert" align = 'center'><%= notice %></p>    
      </div>
    <% end %>
    <% if alert.blank?%>  
      <div id="hide">
      </div>
    <% else %>
      <div class="alert" role="alert">
      <span class="closebtn" onclick="this.parentElement.style.display='none';">&times;</span> 
      <p class="alert" align = 'center'><%= alert %></p>    
    </div>
    <% end %>
    
    <br>
      	<%= render 'layouts/navigation' %>
        <%= yield %>

        <%= stylesheet_link_tag    'application'%>

    <div class="footer" id="footerbelow">

      <div class="row" >

        <div class="col-sm-1">
          <!--empty-->
        </div>

        <div class="col-sm-10" >
          <p ><small><i class="fas fa-map-marker-alt fa-sm"></i>Ground floor, Arcadia Bldg. 860 Quezon Ave. Brgy. Paligsahan 1103, Quezon City <i class="fas fa-phone fa-sm"></i> +632 84415752 / 0917-8844595 <i class="fas fa-envelope fa-sm"></i> info@pitsph.com   <i class=""></i> | <%= link_to 'Privacy Notice', privacies_path, id:'privacyid'%> </small> </p>
        </div>

        
         <div class="col-sm-1">
          <!--empty-->
        </div>

      </div>

    </div>
</div>

</body>
</html>
