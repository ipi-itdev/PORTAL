<!DOCTYPE html>
<html>
<head>

  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>

  <style type="text/css">
    
    #required_field {
      position: absolute;
      bottom: px;
      left: 7px;
      font-size: 18px;
      color: red;
    }

  </style>





  <script type="text/javascript">
    
    $(document).ready(function() { /* code here */ 

       $("#client_div").css("visibility", "hidden");

    });

    $('document').ready(function() {
        $("#tre_expense_detail_ClientAccountRefNo").prepend('<option value="">n/a</option>');
      }
      );
  </script>


</head>


<body onload="myFunctionload()">

<script>
function myFunctionload() {
      var selected_value = $('#tre_expense_detail_tre_category_refno').find(":selected").text();

      if (selected_value == "Communication" ) 
      {
        //alert("Please Select a Client");
        $( "#submit_detail_but" ).prop('disabled', true);
        $( "#tre_expense_detail_ClientAccountRefNo" ).prop('disabled', false);  
      } 
      else if (selected_value == "Transportation")
      {
        //alert("Please Select a Client");
        $( "#submit_detail_but" ).prop('disabled', true);
        $( "#tre_expense_detail_ClientAccountRefNo" ).prop('disabled', false);  
      }

      else
      {
        //document.getElementById("tre_expense_detail_ClientAccountRefNo").selectedIndex = 0;
        $( "#submit_detail_but" ).prop('disabled', false);
        //$( "#tre_expense_detail_ClientAccountRefNo" ).prop('disabled', true);
      }

}
</script>


<div class="container-fluid">
    <%= bootstrap_form_with(model: tre_expense_detail, local: true)  do |form| %>
    <% if tre_expense_detail.errors.any? %>
      <div id="error_explanation">
        <ul>
        <% tre_expense_detail.errors.full_messages.each do |message| %>
          
        <% end %>
        </ul>
      </div>
    <% end %>


    <div class="row">
      <div class="col-sm-6" >

        <% get_emp_details = PisEmploymentInfoU.where(EmployeeRefNo: current_user.EmployeeRefNo, IsActive: 1).pluck_to_hash(:ClientAccountRefNo, :EmployeeGroupRefNo, :JobPosition,:DepartmentRefNo) %>

        <% hash_get_emp_details = get_emp_details[0] %>

        <% get_manager_userrefno = GenDepartmentM.where(DepartmentRefNo: hash_get_emp_details[:DepartmentRefNo]).pluck(:UserRefNo).first %>

        <% get_manager_departments = GenDepartmentM.where(UserRefNo: get_manager_userrefno).pluck(:DepartmentRefNo) %>

          <%= form.hidden_field :ExpenseRefNo, value: session[:tre_expense_id] %>
          <%= form.hidden_field :EmployeeRefNo, value: current_user.EmployeeRefNo %>
          <%= form.hidden_field :CreatedDate, value: DateTime.now + 8.hours %>
          <%= form.hidden_field :CreatedBy, value: current_user.EmployeeRefNo %>
          <%= form.hidden_field :ModifiedDate, value: DateTime.now + 8.hours %>
          <%= form.hidden_field :ModifiedBy, value: current_user.EmployeeRefNo %>
          <%= form.hidden_field :IsActive, value: true %>
          <%= form.hidden_field :ServerCompanyCodeID, value: '1-1' %>


           <small><strong><%= form.collection_select :EntryRefNo, BilEntryM.where(ForTRE: 1),:EntryRefNo, :Description, label: 'Entry Type' %></strong></small>
  


      </div>

      <div class="col-sm-6" >
     
        <small><strong><%= form.text_area :Description, class: 'form-control input-sm' %></strong></small>
        

      </div>
    </div>

    <div class="row">
      <div class="col-sm-6" >

        <small><strong><%= form.collection_select :ClientAccountRefNo, GenClientAccountM.where(IsActive: 1),:ClientAccountRefNo, :Description, label: 'Client Account' %></strong></small>



        

      </div>
      <div class="col-sm-6" >


        <p id="required_field"> *</p>
        <small><strong><%= form.number_field :Amount, step: '0.01',  placeholder:'0.00', min:'0' %></strong></small>

        <script type="text/javascript">
          $( "#tre_expense_detail_Amount" ).blur(function() {
            this.value = parseFloat(this.value).toFixed(2);
          });
        </script>



        <p id="required_field"> *</p>
        <small><strong><%= form.file_field :AttachmentFile, label: 'Attach File', onchange: "myFunction_hidediv()", :accept => 'image/jpeg,image/jpg,image/png,image/gif,application/pdf' %></strong></small>


        <script type="application/javascript">
            $('input[type="file"]').change(function(e){
                var fileName = e.target.files[0].name;
                $('.custom-file-label').html(fileName);
            });
        </script>

        <script>
          function myFunction_hidediv() {
            var x = document.getElementById("tre_expense_detail_AttachmentFile").value;
            $("#div_filepath").hide();
            //document.getElementById("div_filepath").style.display = "none";
            //alert("hello w"); 
          }
        </script>
        

        <div id="div_filepath">
          <small><a href="<%= @tre_expense_detail.AttachmentFile%>" target="_blank"> <%= @tre_expense_detail.AttachmentFile_identifier %> </a> </small>
        </div>

        <small><%= form.hidden_field :AttachmentFile_cache %></small>

      </div>
    </div>

    <div class="row">
      <div class="col-sm-12" >

      </div>
    </div>

  <br>
  <br>  


  <div class="row">
    <div class="col-sm-6" >

    </div>
    <div class="col-sm-6" >
      
      

        <div class="row">
          <div class="col-sm-6" >
            <%= form.submit 'Save', class:'btn btn-success btn-sm btn-block', id: 'submit_detail_but' %>
          </div>

          <div class="col-sm-6" >
            <%= link_to 'Back to List', tre_expense_details_path, class:'btn btn-primary btn-sm btn-block' %>
          </div>
        </div>
    </div>
  </div>
</div>


<% end %>



</body>
</html>





