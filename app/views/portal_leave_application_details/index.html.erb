<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.2/css/all.css" integrity="sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr" crossorigin="anonymous">
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>
  <link rel="stylesheet" type="text/css" href="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/css/jquery.dataTables.css">
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-6" >
        <p id="notice"><%= notice %></p>    
        <% get_filing_stat = PortalLeaveApplication.where(ID: session[:portal_leave_application_id]).pluck(:FilingStatusRefNo).to_sentence %>
      </div>

      <div class="col-sm-6"  align="right">
        <% if get_filing_stat.to_i == 1 && @leaveapproval != 1 %>
          <p><%= link_to '<i class="fa fa-plus" aria-hidden="true"></i> Add detail'.html_safe, new_portal_leave_application_detail_path, class:'btn btn-success btn-sm' %></p>
        <% end %>
      </div>
    </div>

    <strong>Leave Details</strong>  
    <div class="table-responsive">
      <table class="table table-striped table-condensed" id="portal_leave_application_detail_table">    
        <thead>
          <tr>
            <th ><small><b>ID</b></small></th>
            <th ><small><b>Leave Type</b></small></th>            
            <th ><small><b>Date</b></small></th>      
            <th ><small><b>Credits</b></small></th>
            <th ><small><b>Reason</b></small></th>
            <% if @employee_group == '2' %>
              <th ><small><b>As SL</b></small></th>   
              <th ><small><b>As EL</b></small></th>      
            <% end %>
            <th ></th>
          </tr>
        </thead>

        <tbody>
          <% @portal_leave_application_details.each do |portal_leave_application_detail| %>
            <tr>
              <td><small><%= portal_leave_application_detail.ID %></small></td>
              <td><small><%=  GenLeaveTypeM.where(LeaveTypeRefNo: portal_leave_application_detail.LeaveTypeRefNo).pluck(:Description).to_sentence %></small></td>                      
              <td ><small><%= portal_leave_application_detail.WorkDate.strftime("%m/%d/%Y") %></small></td>
              <td><small><%=  PortalLeaveApplicationCredit.where(LeaveCreditTypeRefNo: portal_leave_application_detail.LeaveCreditTypeRefNo).pluck(:Description).to_sentence %></small></td>        
              <td><small><%= portal_leave_application_detail.Reason %></small></td>
              <% if @employee_group == '2' %>
                <td ><small><%= portal_leave_application_detail.AsSL %></small></td>
                <td ><small><%= portal_leave_application_detail.AsEL %></small></td>
              <% end %>

              <td align="center">
                  <% if get_filing_stat.to_i == 1 && @leaveapproval != 1 %>                
                    <div class="btn-group btn-group-sm btn-group-block" role="group" aria-label="Basic example">
                      <%= link_to '<i class="far fa-edit"></i>'.html_safe, edit_portal_leave_application_detail_path(portal_leave_application_detail), class: 'btn btn-secondary', data: { confirm: 'Are you sure? test' }, "data-toggle" => "tooltip", "data-placement" => "top", "title" => "Edit" %>
                      <%= link_to '<i class="far fa-trash-alt"></i>'.html_safe, tmsdetailremove_index_path(detail_refno: portal_leave_application_detail.ID, tms_type: 'leave'), method: 'post', data: { confirm: 'Are you sure? test' }, class: 'btn btn-danger', "data-toggle" => "tooltip", "data-placement" => "top", "title" => "Delete" %>                                           
                    </div>

                  <% else %>
                    <%= link_to '<i class="far fa-file"></i>'.html_safe, portal_leave_application_detail, class: 'btn btn-secondary', "data-toggle" => "tooltip", "data-placement" => "top", "title" => "View" %>             
                  <% end%>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.8.2.min.js"></script>
      <script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/jquery.dataTables.min.js"></script>
      <script>
        $(function(){
          $("#portal_leave_application_detail_table").dataTable();
        })
      </script>
    </div>
  </div>
</body>
</html>