<script>

  document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_end_4i").addEventListener("change", shiftendFunc);

  function shiftendFunc() {

    var shift_end_yr = $('#portal_dhs_employee_weekly_schedule_u_shift_end_1i').val()
    var shift_end_mons = $('#portal_dhs_employee_weekly_schedule_u_shift_end_2i').val()
    var shift_end_day = $('#portal_dhs_employee_weekly_schedule_u_shift_end_3i').val()
    var shift_end_hrs = $('#portal_dhs_employee_weekly_schedule_u_shift_end_4i').val()
    var shift_end_mins = $('#portal_dhs_employee_weekly_schedule_u_shift_end_5i').val()
    var shift_end_result = shift_end_hrs.concat(shift_end_mins);

    var shift_start_hrs = $('#portal_dhs_employee_weekly_schedule_u_shift_start_4i').val()
    var shift_start_mins = $('#portal_dhs_employee_weekly_schedule_u_shift_start_5i').val()
    var shift_start_result = shift_start_hrs.concat(shift_start_mins);


   if (shift_end_result < shift_start_result )
   {
      <% get_workdate = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date %>
      <% get_workdate_PlusOne = get_workdate.advance(days: 1) %>
      <% get_yr_PlusOne = get_workdate_PlusOne.strftime("%Y") %>
      <% get_mon_PlusOne = get_workdate_PlusOne.strftime("%m") %>
      <% get_day_PlusOne = get_workdate_PlusOne.strftime("%d") %>
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_1i").val('<%= get_yr_PlusOne %>');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_2i").val('<%= get_mon_PlusOne %>');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_3i").val('<%= get_day_PlusOne %>');
         
   }
  }


  document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_end_5i").addEventListener("change", shiftend_minFunc);

  function shiftend_minFunc() {

    var shift_end_yr = $('#portal_dhs_employee_weekly_schedule_u_shift_end_1i').val()
    var shift_end_mons = $('#portal_dhs_employee_weekly_schedule_u_shift_end_2i').val()
    var shift_end_day = $('#portal_dhs_employee_weekly_schedule_u_shift_end_3i').val()
    var shift_end_hrs = $('#portal_dhs_employee_weekly_schedule_u_shift_end_4i').val()
    var shift_end_mins = $('#portal_dhs_employee_weekly_schedule_u_shift_end_5i').val()
    var shift_end_result = shift_end_hrs.concat(shift_end_mins);
    
    var shift_start_hrs = $('#portal_dhs_employee_weekly_schedule_u_shift_start_4i').val()
    var shift_start_mins = $('#portal_dhs_employee_weekly_schedule_u_shift_start_5i').val()
    var shift_start_result = shift_start_hrs.concat(shift_start_mins);


   if (shift_end_result < shift_start_result )
   {
      <% get_workdate = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date %>
      <% get_workdate_PlusOne = get_workdate.advance(days: 1) %>
      <% get_yr_PlusOne = get_workdate_PlusOne.strftime("%Y") %>
      <% get_mon_PlusOne = get_workdate_PlusOne.strftime("%m") %>
      <% get_day_PlusOne = get_workdate_PlusOne.strftime("%d") %>
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_1i").val('<%= get_yr_PlusOne %>');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_2i").val('<%= get_mon_PlusOne %>');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_3i").val('<%= get_day_PlusOne %>');
         
   }
  }


  document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_start_4i"  ).addEventListener("change", shiftstartFunc);

      function shiftstartFunc() {

        var get_shiftstart_hours_val = $("#portal_dhs_employee_weekly_schedule_u_shift_start_4i").val();
        var get_shiftstart_mins_val  = $("#portal_dhs_employee_weekly_schedule_u_shift_start_5i").val();
        $("#portal_dhs_employee_weekly_schedule_u_shift_end_4i").val(get_shiftstart_hours_val);
        $("#portal_dhs_employee_weekly_schedule_u_shift_end_5i").val(get_shiftstart_mins_val);
        
  }


  document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_start_5i"  ).addEventListener("change", shiftstart_minFunc);

      function shiftstart_minFunc() {
        var get_shiftstart_mins1_val  = $("#portal_dhs_employee_weekly_schedule_u_shift_start_5i").val();
        $("#portal_dhs_employee_weekly_schedule_u_shift_end_5i").val(get_shiftstart_mins1_val);
  }


</script>

 
    <script type="text/javascript">
      //reset button
      document.getElementById("reset_but").addEventListener("click", resetFunc);

      function resetFunc() {

        <% if @portal_dhs_employee_weekly_schedule_u.IsRD == true %>

          <% get_start_yr1 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%Y") %>
          <% get_start_mon1 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%m") %>
          <% get_start_day1 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%-d") %>
          <% get_start_hrs1 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%H") %>
          <% get_start_mins1 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%M") %>
          $("#portal_dhs_employee_weekly_schedule_u_shift_start_1i").val('<%= get_start_yr1 %>');
          $("#portal_dhs_employee_weekly_schedule_u_shift_start_2i").val('<%= get_start_mon1 %>');
          $("#portal_dhs_employee_weekly_schedule_u_shift_start_3i").val('<%= get_start_day1 %>');
          $("#portal_dhs_employee_weekly_schedule_u_shift_start_4i").val('<%= get_start_hrs1 %>');
          $("#portal_dhs_employee_weekly_schedule_u_shift_start_5i").val('<%= get_start_mins1 %>');

          <% get_end_yr1 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%Y") %>
          <% get_end_mon1 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%m") %>
          <% get_end_day1 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%-d") %>
          <% get_end_hrs1 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%H") %>
          <% get_end_mins1 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%M") %>
          $("#portal_dhs_employee_weekly_schedule_u_shift_end_1i").val('<%= get_end_yr1 %>');
          $("#portal_dhs_employee_weekly_schedule_u_shift_end_2i").val('<%= get_end_mon1 %>');
          $("#portal_dhs_employee_weekly_schedule_u_shift_end_3i").val('<%= get_end_day1 %>');
          $("#portal_dhs_employee_weekly_schedule_u_shift_end_4i").val('<%= get_end_hrs1 %>');
          $("#portal_dhs_employee_weekly_schedule_u_shift_end_5i").val('<%= get_end_mins1 %>');
          alert("Resetting Shifts!.");

        <% else %>


          <% if @portal_dhs_employee_weekly_schedule_u.shift_start.to_date < @portal_dhs_employee_weekly_schedule_u.shift_end.to_date %>

            <% get_start_yr2 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%Y") %>
            <% get_start_mon2 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%m") %>
            <% get_start_day2 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%-d") %>
            $("#portal_dhs_employee_weekly_schedule_u_shift_start_1i").val('<%= get_start_yr2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_start_2i").val('<%= get_start_mon2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_start_3i").val('<%= get_start_day2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_start_4i").val('00');
            $("#portal_dhs_employee_weekly_schedule_u_shift_start_5i").val('01');

            <% get_end_yr2 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%Y") %>
            <% get_end_mon2 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%m") %>
            <% get_end_day2 = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%-d") %>
           
            $("#portal_dhs_employee_weekly_schedule_u_shift_end_1i").val('<%= get_end_yr2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_end_2i").val('<%= get_end_mon2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_end_3i").val('<%= get_end_day2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_end_4i").val('00');
            $("#portal_dhs_employee_weekly_schedule_u_shift_end_5i").val('01');
            alert("Resetting Shifts!..");

          <% else %>

            <% get_start_yr2 = @portal_dhs_employee_weekly_schedule_u.shift_start.to_date.strftime("%Y") %>
            <% get_start_mon2 = @portal_dhs_employee_weekly_schedule_u.shift_start.to_date.strftime("%m") %>
            <% get_start_day2 = @portal_dhs_employee_weekly_schedule_u.shift_start.to_date.strftime("%-d") %>
            <% get_start_hrs2 = @portal_dhs_employee_weekly_schedule_u.shift_start.strftime("%H") %>
            <% get_start_mins2 = @portal_dhs_employee_weekly_schedule_u.shift_start.strftime("%M") %>
            $("#portal_dhs_employee_weekly_schedule_u_shift_start_1i").val('<%= get_start_yr2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_start_2i").val('<%= get_start_mon2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_start_3i").val('<%= get_start_day2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_start_4i").val('<%= get_start_hrs2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_start_5i").val('<%= get_start_mins2 %>');

            <% get_end_yr2 = @portal_dhs_employee_weekly_schedule_u.shift_end.to_date.strftime("%Y") %>
            <% get_end_mon2 = @portal_dhs_employee_weekly_schedule_u.shift_end.to_date.strftime("%m") %>
            <% get_end_day2 = @portal_dhs_employee_weekly_schedule_u.shift_end.to_date.strftime("%-d") %>
            <% get_end_hrs2 = @portal_dhs_employee_weekly_schedule_u.shift_end.strftime("%H") %>
            <% get_end_mins2 = @portal_dhs_employee_weekly_schedule_u.shift_end.strftime("%M") %>
            $("#portal_dhs_employee_weekly_schedule_u_shift_end_1i").val('<%= get_end_yr2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_end_2i").val('<%= get_end_mon2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_end_3i").val('<%= get_end_day2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_end_4i").val('<%= get_end_hrs2 %>');
            $("#portal_dhs_employee_weekly_schedule_u_shift_end_5i").val('<%= get_end_mins2 %>');
            alert("Resetting Shifts!...");

          <% end %>


        <% end %>  
       
       }
    </script>

    <script type="text/javascript">
      $("#portal_dhs_employee_weekly_schedule_u_shift_start_1i").on("keydown keypress keyup click contextmenu", false);
    </script>


<% end %>

<br>
<br>
</body>
</html>
