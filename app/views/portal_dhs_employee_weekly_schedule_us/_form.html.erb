<!DOCTYPE html>
<html>
<head>



 <style type="text/css">
   #portal_dhs_employee_weekly_schedule_u_shift_start_1i, #portal_dhs_employee_weekly_schedule_u_shift_start_2i, #portal_dhs_employee_weekly_schedule_u_shift_start_3i, #portal_dhs_employee_weekly_schedule_u_shift_end_1i, #portal_dhs_employee_weekly_schedule_u_shift_end_2i, #portal_dhs_employee_weekly_schedule_u_shift_end_3i {
      pointer-events: none;
      border: 1px solid grey;
      background-color: lightgrey;
       appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      user-select: none;

      
   }


 </style> 

</head>
<body >



<div class="container-fluid">

  <%= bootstrap_form_with(model: portal_dhs_employee_weekly_schedule_u, local: true) do |form| %>
  <% if portal_dhs_employee_weekly_schedule_u.errors.any? %>
    <div id="error_explanation">
      <!--<h2><%= pluralize(portal_dhs_employee_weekly_schedule_u.errors.count, "error") %> prohibited this portal_dhs_employee_weekly_schedule_u from being saved:</h2> -->

      <ul align='center'>
      <% portal_dhs_employee_weekly_schedule_u.errors.full_messages.each do |message| %>
        <li align='center' style="color: red;"><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-sm-4" >


    </div>

    <div class="col-sm-4" >



      <div class="panel panel-default">

        <div class="panel-heading" id="panelheader">
          <i class="fa fa-calendar" aria-hidden="true"></i><strong>Edit My Schedule</strong>
        </div>

        <div class="panel-body" id="panelframe">
  
          <div class="row">
            <div class="col-sm-12" >
             <b>Workdate:</b> <%= @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%m/%d/%Y") %>
            </div>
            <div class="col-sm-12" >
             <%= form.check_box :IsRD,  onclick: "check_RD_Func()", label: 'Is My Restday?', id:'checkbox'%>
            </div>
          </div>

            <br>
      
        <div class="row">

          <div class="col-sm-6" >
            <%= form.datetime_select :shift_start , label: 'Shift Start',  ampm: true %>
          </div>
           <div class="col-sm-6" >
            <%= form.datetime_select :shift_end , label: 'Shift End',  ampm: true  %>
           <button type="button" id="reset_but" class='btn btn-primary btn-block btn-sm'>Reset Shifts <i class="fa fa-refresh" aria-hidden="true"></i></button>
          </div>

        </div>

        <br>


        <br>
        <br>
        <div class="row">
          <div class="col-sm-12" >      
            <%= form.submit 'Save', class:'btn btn-primary btn-block btn-sm', id:'save_sched_button',  data: { disable_with: " Please wait..." }%>
            <%= link_to 'Back', portal_dhs_employee_weekly_schedule_us_path, class:'btn btn-primary btn-block btn-sm', id: 'back_sched_button' %>
          </div>
        </div>

        </div>



        </div>
      </div>

    </div>

    <div class="col-sm-4" >

    </div>



  </div>
</div>



<script type="text/javascript">
  //RD checkbox
  function check_RD_Func() 
  {
    
    if($("#checkbox").prop('checked') == true)
    {
      //checked  
      $("#portal_dhs_employee_weekly_schedule_u_shift_start_1i").val('');
      $("#portal_dhs_employee_weekly_schedule_u_shift_start_2i").val('');
      $("#portal_dhs_employee_weekly_schedule_u_shift_start_3i").val('');
      $("#portal_dhs_employee_weekly_schedule_u_shift_start_4i").val('');
      $("#portal_dhs_employee_weekly_schedule_u_shift_start_5i").val('');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_1i").val('');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_2i").val('');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_3i").val('');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_4i").val('');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_5i").val('');
      document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_start_4i").disabled = true;
      document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_start_5i").disabled = true;
      document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_end_4i").disabled = true;
      document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_end_5i").disabled = true;
      document.getElementById("reset_but").style.display = "none"
    }
    else
    {
      //NOT checked

      <%= get_yr_uncheck= @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%Y") %>
      <%= get_mon_uncheck = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%m") %>
      <%= get_day_uncheck = @portal_dhs_employee_weekly_schedule_u.WorkDate.to_date.strftime("%-d") %>

      $("#portal_dhs_employee_weekly_schedule_u_shift_start_1i").val('<%= get_yr_uncheck %>');
      $("#portal_dhs_employee_weekly_schedule_u_shift_start_2i").val('<%= get_mon_uncheck %>');
      $("#portal_dhs_employee_weekly_schedule_u_shift_start_3i").val('<%= get_day_uncheck %>');

      $("#portal_dhs_employee_weekly_schedule_u_shift_end_1i").val('<%= get_yr_uncheck %>');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_2i").val('<%= get_mon_uncheck %>');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_3i").val('<%= get_day_uncheck %>');

      document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_start_4i").disabled = false;
      document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_start_5i").disabled = false;
      document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_end_4i").disabled = false;
      document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_end_5i").disabled = false;

      $("#portal_dhs_employee_weekly_schedule_u_shift_start_4i").val('00');
      $("#portal_dhs_employee_weekly_schedule_u_shift_start_5i").val('00');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_4i").val('00');
      $("#portal_dhs_employee_weekly_schedule_u_shift_end_5i").val('00');
      document.getElementById("reset_but").style.display = "block"
    }
  }


  //onload func
  function hidedivFunction() {
    $("#savingsaveschedmsg").hide();
    document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_start_date").disabled = true;
    document.getElementById("portal_dhs_employee_weekly_schedule_u_shift_start_time").disabled = true;
  }


  //on click save button
  document.getElementById('save_sched_button').onclick = function() {
    $("#back_sched_button").prop('disabled', true);
    //$("#save_sched_button").prop('disabled', true);
    //$( "#timeoutdisabled_button" ).show();
    //$( "#save_sched_button" ).hide();
    //$("#savingsaveschedmsg").show();

  }
</script>

