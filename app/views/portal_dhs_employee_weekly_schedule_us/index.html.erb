<!DOCTYPE html>
<html>
<head>
  

<style>


@media screen and (min-width: 500px) {
  .mobile-menu {
    display: none !important;
  }
}

@media screen and (max-width: 500px) {
  .pc-menu {
    display: none !important;
  }
}

#timestamp {
  font-size: 9px;
}


</style>


</head>
<body onload="onloadFunction()">




<div class="container-fluid">


<!-- <p id="notice" align="center" style="color: red;"><%= notice %></p> -->



  <div class="row">
    <div class="col-sm-3" >
      
    </div>
    <div class="col-sm-6" >
      <div class="panel panel-default" id="panelframe">

        <div class="panel-heading" id="panelheader">
          <% get_date = ActiveRecord::Base.connection.exec_query("SELECT CAST(DATEADD(HOUR,8,GETUTCDATE()) AS DATE)").rows[0][0] %>
          <% if @foredit == 0 %>
                        
            <% if mobile_device == "mobile" %>

              <table>
                <tr>
                  <td width="50%"><strong>My Weekly Schedule</strong></td>
                  <td width="30%" align="right"><b><small></small></b></td>
                  <td width="20%" align="right"><b><small><a target="_blank" href= '/manuals/weeklyschedule.pdf' style="color: white; " title="User's Manual" rel="tooltip"> <ic class="glyphicon glyphicon-info-sign " ></ic> </a></small></b></td>
                </tr>
              </table>

            <% else %>

              <div class="row">
                <div class="col-sm-11">
                  <strong>My Weekly Schedule</strong>
                </div>
                <div class="col-sm-1" align="center">
                  <a target="_blank" href= '/manuals/weeklyschedule.pdf' style="color: white; font-size:5px" title="User's Manual" rel="tooltip"> <ic class="glyphicon glyphicon-info-sign " ></ic> </a>
                </div>
              </div>

            <% end %>
            
          <% else %>      
            <div class="row">
              <div class="col-sm-11" >                                            
                <strong>DTR Timesheet</strong>
              </div>

              <% if mobile_device == "mobile" %>
                <br>
                <div class="col-sm-1" >
                  <div class="btn-group">                  
                    <%= button_tag '<i class="fa fa-info-circle"></i>'.html_safe, method: 'post', class: "btn btn-primary", "data-toggle" => "tooltip", "data-placement" => "top", "title" => "User Manual", id: 'usermanual' %>
                  </div>
                </div>
              <% else %>
                <div class="col-sm-1" >              
                  <%= button_tag '<i class="fa fa-info-circle"></i>'.html_safe, method: 'post', class: "btn btn-primary btn-block btn-sm", "data-toggle" => "tooltip", "data-placement" => "top", "title" => "User Manual", id: 'usermanual' %>
                </div>    
              <% end %>                
            </div>            
          <% end %>          
        </div>

        <div class="panel-body">

          <div class="row">
            <div class="col-sm-6" >

                <table style="width:100%">
                  
                  <tr>
                    <td>
                      <div id="fix_sched_div">
                        <%= hidden_field_tag :employeerefno, current_user.EmployeeRefNo %>
                        <% if @foredit == 0 %>
                          <%= link_to 'Set default schedule'.html_safe, '/fixedschedulepage', class:'btn btn-primary btn-sm' %>
                        <% else %>                                                  
                          <%= link_to "Request DTR", request_dtr_path(), method: 'post',  class: "btn btn-primary btn-sm", data: { confirm: 'Are you sure you sure you want to request this DTR?', disable_with: "<i class='fa fa-spinner fa-spin'></i> Please wait..." } %>
                        <% end %>
                      </div>
                    </td>

                    <td align="center">
                        <% if @foredit == 0 %>
                          <%= link_to 'My Timesheet'.html_safe, '/weekschedhist', class:'btn btn-primary btn-sm' %>
                        <% end %>
                    </td>
            
                  </tr>
        
                </table>

            </div>


          </div>


        <!---mobile -->
        <% if mobile_device == "mobile" %>

        <table class="table table-bordered table-condensed" >

          <tbody>
            <% @weeksched.each do |weeksched|%>
            
            
              <tr align="left">

                <td>
                  <% if weeksched.shift_start.blank? == true || weeksched.time_in.blank? == true || get_date - 1.days <= weeksched.WorkDate.to_date || weeksched.IsRD == true || @foredit == 1 %>

                    <small><%= link_to '<i class="far fa-edit" style="color: green;"></i>'.html_safe, "/portal_dhs_employee_weekly_schedule_us/#{weeksched.ID}/edit", :title => 'Edit Schedule', :rel => 'tooltip' %></small>
                    <% weeksched.ID %>
                  <% end %>
                  


                </td>

                <td>
                  <small>Workdate:</small>
                  <br>
                  Shifts:
                  <br>
                  Logs:
                </td>

                <td>
                <small ><%= weeksched.WorkDate.to_date.strftime("%m/%d/%Y %a ") %>   </small>
                <br>
                  <% if weeksched.shift_start.blank? == true %>
                      <!--nothing to do -->
                  <% else %>
                    <small id="timestamp"><%= weeksched.shift_start.strftime("%m/%d %H:%M") %></small>
                  <% end %> 
                  /
                  <% if weeksched.shift_end.blank? == true %>
                      <!--nothing to do -->
                  <% else %>
                    <small id="timestamp"><%= weeksched.shift_end.strftime("%m/%d %H:%M") %></small>
                  <% end %>
                <br>

                  <% if weeksched.time_in.blank? == true %> 
                    -
                  <% else %>
                    <small id="timestamp"><%= weeksched.time_in.strftime("%m/%d %H:%M") %></small>
                  <% end %>
                  /
                  <% if weeksched.time_out.blank? == true  %>
                  -
                  <% else %>  
                    <small id="timestamp"><%= weeksched.time_out.strftime("%m/%d %H:%M") %></small>
                  <% end %>


                </td>


              </tr>


              <% end %>
            

        </table>
          

 
        <!---mobile -->

        <% else %>

        <!---desktop--->
        <table  class="table table-bordered table-condensed">
          <thead class="thead-dark" >
            <div>
            <tr align="center">
              <th align="left"><small>Work Date</small></th>
              <th align="center"><small>Is Rest Day?</small></th>
              <th><small>Shift Start</small></th>
              <th><small>Shift End</small></th>
              <th><small>Time-in</small></th>
              <th><small>Time-out</small></th>
            </tr>
            </div>

          </thead>
          <tbody>
            <% @weeksched.each do |weeksched|%>
            
            
              <tr align="left">

                <td> 
                  <small><%= weeksched.WorkDate.to_date.strftime("%m/%d/%Y %A ") %>  </small>
                  <br>

                  <% if weeksched.shift_start.blank? == true || weeksched.time_in.blank? == true || get_date - 1.days <= weeksched.WorkDate.to_date || weeksched.IsRD == true || @foredit == 1 %>
                    <small><%= link_to '<i class="far fa-edit"></i>'.html_safe, "/portal_dhs_employee_weekly_schedule_us/#{weeksched.ID}/edit", :title => 'Edit Schedule', :rel => 'tooltip' %></small>
                    <% weeksched.ID %>
                  <% end %>

                </td>

                <td align="center">
                  <small>
                    <% if weeksched.IsRD == true %>
                      Yes
                    <% else %>
                      No
                    <% end %>
                  
                    
                  </small>
                </td>

                <td>
                  <% if weeksched.shift_start.blank? == true %>
                      <!--nothing to do -->
                  <% else %>
                    <small><%= weeksched.shift_start.strftime("%m/%d %H:%M") %></small>
                  <% end %> 
                  
                </td>

                <td>

                  <% if weeksched.shift_end.blank? == true %>
                      <!--nothing to do -->
                  <% else %>
                    <small><%= weeksched.shift_end.strftime("%m/%d %H:%M") %></small>
                  <% end %> 
                  
                </td>

                  <!-- start time in -->
                <td>
                  
                  <% if weeksched.time_in.blank? == true %> 
                    -
                  <% else %>
                    <small><%= weeksched.time_in.strftime("%m/%d %H:%M") %></small>
                  <% end %>
            
                </td>
                  <!-- end time in -->

                  <!-- start time out -->
                <td>

                  <% if weeksched.time_out.blank? == true  %>
                  -
                  <% else %>  
                    <small><%= weeksched.time_out.strftime("%m/%d %H:%M") %></small>
                  <% end %>


                </td>
                  <!-- end time out -->

              </tr>


              <% end %>
            

        </table>  

        <% end %>
        <!---desktop--->


        </div>
      </div>



      <br>


    </div>

    <div class="col-sm-3" >

      <!-- empty -->

    </div>

  </div>
</div>

<script type="text/javascript">
  document.getElementById('fixed_sched_true').onclick = function() {
    //$("#fixedschedButton").click();
    $("#fixedschedlink").click();
    //alert("test");
    
};
</script>

<script type="text/javascript">
  document.getElementById('fixed_sched_false').onclick = function() {
    $("#submit_button").click();
};
</script>

<% if @foredit != 0 %>
<div id="myModal" class="modal">
  <!-- Modal content -->
  <div class="modal-content" style="width: 50%; position: absolute; left: 25%;">
    <span class="close">&times;</span>
    <iframe  src="\manuals\dtrtimesheet.pdf"  style="border:none;" title="IframeExpenseDetails" height="500px" width="100%"> </iframe>
  </div>
</div>

<script>
  var modal = document.getElementById("myModal");
  var btn = document.getElementById("usermanual");
  var span = document.getElementsByClassName("close")[0];

  <% if mobile_device == "mobile" %>
    btn.onclick = function() {
      window.open("/manuals/dtrtimesheet.pdf");
    }

  <% else %>
    btn.onclick = function() {
    modal.style.display = "block";
    }

    span.onclick = function() {
      modal.style.display = "none";
    }

    window.onclick = function(event) {
      if (event.target == modal) {
        modal.style.display = "none";
      }
    }
  <% end %>
</script>
<% end %>

<br>
<br>
<br>


</body>
</html>









