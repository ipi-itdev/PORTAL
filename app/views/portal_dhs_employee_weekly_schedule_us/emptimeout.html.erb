  <div class="row">
    <div class="col-sm-4" >

    </div>
    <div class="col-sm-4" >

    	<h5 style="color: red;">*Tasks Performed</h5>

		<% if @datetime_range.blank? == true %>


		<% else %>

		       
		        <%= form_tag('/timeout', method:'post') do %>

		            <%= hidden_field_tag :id_rec, @datetime_range.rows[0][0] %>
		            <%= hidden_field_tag :emprefno_rec, current_user.EmployeeRefNo %>

		            <% if @datetime_range.rows[0][7].blank? == true #task%>
							  	<%= cktext_area_tag :task_tag, nil, ckeditor: {resize_enabled:false, removePlugins: "toolbar,elementspath", toolbar: 'mini'} %>								  
		            <% else %>
							  	<%= cktext_area_tag :task_tag, @datetime_range.rows[0][7], ckeditor: {resize_enabled:false, removePlugins: "toolbar,elementspath", toolbar: 'mini'} %>
		            <% end %>	

		        	<br>

		            <%= button_tag(type: 'submit', class: 'btn btn-primary btn-md btn-block', id:'timeout_page_button') do %>
