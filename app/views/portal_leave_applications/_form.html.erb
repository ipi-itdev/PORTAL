<style type="text/css"> 
    #required_field {         
      position: absolute;
      bottom: px;
      left: 7px;
      font-size: 18px;
      color: red;
    }
</style>

<div class="container-fluid">
  <div class="row">
    <div class="col-sm-1" >      
    </div>

    <div class="col-sm-10" >
      <%= bootstrap_form_with(model: portal_leave_application, local: true) do |form| %>
        <% if portal_leave_application.errors.any? %>
          <div id="error_explanation">
            <ul>
              <% portal_leave_application.errors.full_messages.each do |message| %>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% session[:portal_leave_application_id] = @portal_leave_application.id %>

        <div class="panel panel-default" id="panelframe" style="">
          <div class="panel-heading" id="panelheader" >
            <i class="fas fa-calendar-check"></i> <strong>Leave Application</strong>
          </div>

          <div class="panel-body">
            <div class="row">
              <div class="col-sm-4" >
                <div class="row">
                  <div class="col-sm-12" >
                  <small>
                    <div class="row">                      
                      <div class="col-sm-4" >
                        <strong>ID: </strong>
                      </div>

                      <div class="col-sm-8" >
                        <%=  @portal_leave_application.ID %>
                      </div>                                                                                
                    </div>

                    <br>

                    <div class="row">
                      <div class="col-sm-4" >
                        <strong>Created Date: </strong>
                      </div>

                      <div class="col-sm-8" >
                        <%= @portal_leave_application.DateFiled.strftime("%m/%d/%Y") %>
                      </div>
                    </div>

                    <div class="row">
                      <div class="col-sm-4" >
                        <strong>Created By: </strong>
                      </div>

                      <div class="col-sm-8" >
                        <%= PisEmployeeU.where(EmployeeRefNo: @portal_leave_application.CreatedBy).pluck(:Description).to_sentence %>
                      </div>
                    </div>

                    <br>

                    <div class="row">                      
                      <div class="col-sm-4" >
                        <strong>Status: </strong>
                      </div>

                      <div class="col-sm-8" >
                        <%= GenFilingStatusF.where(FilingStatusRefNo: @portal_leave_application.FilingStatusRefNo ).pluck(:Description).to_sentence %>
                      </div>
                    </div>
                  </small>  
                  </div>
                </div>

                <div class="row">
                  <div class="col-sm-12" >

                    <br>
                    <br>

                    <div class="row">
                      <% if @portal_leave_application.FilingStatusRefNo.to_i != 40 && @portal_leave_application.FilingStatusRefNo.to_i != 2 %>
                        <div class="col-sm-6" >
                          <%= link_to "Request", post_leave_path(leave_id: portal_leave_application.ID), method: 'post',  class: "btn btn-primary btn-block", data: { confirm: 'Are you sure you want to request this application?', disable_with: "<i class='fa fa-spinner fa-spin'></i> Please wait..." } %>
                        </div>                  
                      <% end %>

                      <div class="col-sm-6" >
                        <%= link_to 'Delete', portal_leave_application, method: :delete, data: { confirm: 'Are you sure you want to delete this application?', disable_with: "<i class='fa fa-spinner fa-spin'></i> Please wait..." },  class: "btn btn-primary btn-block" %>                                       
                      </div>
                    </div>
                    
                    <br>

                    <%= link_to 'Back to List', portal_leave_applications_path, class:'btn btn-primary  btn-block' %>
                  </div>
                </div>
              <% end #  end of form%>
            </div>

            <% if mobile_device == "mobile" %>
              <div class="col-sm-8" >
            <% else %>
              <div class="col-sm-8"  style="border-left-style: dotted; border-color: #555555;" >
            <% end %>            

              <iframe src="/portal_leave_application_details?leave_application_id=<%= @get_edit_id.to_param %>" style="border:none;" title="IframeExpenseDetails" height="530px" width="100%"></iframe>
            </div>
          </div>
        </div>
      </div>      
    </div>

    <div class="col-sm-1" >      
    </div>
  </div>
</div>

<br>
<br>