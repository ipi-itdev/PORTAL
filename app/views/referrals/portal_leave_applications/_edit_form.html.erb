<script type="text/javascript">

  document.getElementById("start_date").addEventListener("focusout", myFunction);

  function myFunction()
  
  {
    

    if ($("#start_date").val() != $("#end_date").val() )
      /*start not equal */ 
      {

            if ($("#start_date").val() > $("#end_date").val() )
              {
                  alert("Start Date is greater than End Date");
                  $( "#submit_button" ).prop('disabled', true);
              } 
            else if ($("#start_date").val() == '' || $("#end_date").val() == '') 
              {
                  alert("Start Date / End Date is empty");
                  $( "#submit_button" ).prop('disabled', true); 
              }

            else if ($("#start_date").val() != $("#end_date").val() && $( "#portal_leave_application_end_hrs :selected" ).val() != '8') 
              {
                  alert("Cannot accept less than to 8 hours on a multiple day leave.");

                  $( "#submit_button" ).prop('disabled', true);
              }

            else
              {
                  $( "#submit_button" ).prop('disabled', false);
                  document.getElementById("portal_leave_application_end_hrs").selectedIndex = 0;
                  $( "#portal_leave_application_end_hrs" ).prop('disabled', false);
              }

      }
      /*end not equal */

    /*start equal */
    else if ($("#start_date").val() == '' || $("#end_date").val() == '') 
      {
        /*alert("Start Date is empty");*/
        $( "#submit_button" ).prop('disabled', true);
        
      }

    else if ($("#start_date").val() == $("#end_date").val() && $( "#portal_leave_application_end_hrs :selected" ).val() == '0')
      {


        alert("Cannot apply greater than 8 hrs for a day.");
        $( "#portal_leave_application_end_hrs" ).prop('disabled', false);
        $( "#submit_button" ).prop('disabled', true);

      }


    else
      { 

          $( "#hrs_select" ).show();
          /*$( "#portal_leave_application_end_hrs" ).prop('disabled', true);*/
