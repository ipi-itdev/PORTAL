<%= stylesheet_link_tag    'leave_application_required', media: 'all', 'data-turbolinks-track': 'reload' %>


<div class="container-fluid">
  <%= bootstrap_form_with(model: portal_leave_application, local: true) do |form| %>
  <% if portal_leave_application.errors.any? %>
    <div id="error_explanation">

      <% portal_leave_application.errors.full_messages.each do |message| %>
        <% flash[:notice]= message %>
      <% end %>
 
    </div>
  <% end %>
  
  <div class="row">

    <div class="col-sm-2" >
      
    </div>

     <div class="col-sm-8" >

      <div class="panel panel-default" id="panelframe">
        <div class="panel-heading" id="panelheader">

          <div class="row">
              <div class="col-sm-6" >
                
                <h4 align="left"><i class="fas fa-calendar-check"></i>Edit Leave Application </h4>
       
              </div>
              <div class="col-sm-4" >

                
              </div>
              <div class="col-sm-2" >

                  <%= link_to 'Back', portal_leave_applications_path, class:'btn btn-default btn-block btn-sm' %>
                
              </div>
          </div>
        
        
        
        
        </div>
        <small>
        <!--- start panel body --->
        <div class="panel-body">

          <div class="row">
            <div class="col-sm-6" >
              <strong>Reference No: </strong> <%= @portal_leave_application.id %>
              <br>
              <br>


              <strong>Employee Name:</strong> 
              <br>
              <% hash_emp_details = PisEmployeeU.where(EmployeeRefNo: current_user.EmployeeRefNo).pluck_to_hash(:Description, :EmployeeNumber)%>
              <% emp_details = hash_emp_details[0] %>
              <%= emp_details[:Description]%> - <%= emp_details[:EmployeeNumber]%> 

              <br>
              <br>
              <strong>Application Status: </strong> 
              <br>
              For Submission
              <%= form.hidden_field :leave_status_refno, value: 1 %>
              <%= form.hidden_field :employeerefno, value: current_user.EmployeeRefNo %>
              
            </div>

            <div class="col-sm-6" align="left">
              <strong>Date Filed: <%= @portal_leave_application.created_at.strftime("%m/%d/%Y")%></strong>
            </div>
          </div>
          <br>
          <div class="row">
            <% get_emp_details = PisEmploymentInfoU.where(EmployeeRefNo: current_user.EmployeeRefNo).pluck_to_hash(:EmployeeGroupRefNo)
                get_emp_details = get_emp_details[0] %>

              <% if get_emp_details[:EmployeeGroupRefNo] == 1 #checkdepartment%>
                <div class="col-sm-6" >
                  <p id="leave_application_required"> *</p>
                  <%= form.collection_select :leavetype_refno, GenLeaveTypeM.all,:LeaveTypeRefNo, :Code, label: 'Leave Type ' %>

                </div>
              <% else %>
                <div class="col-sm-6" >
                  <p id="leave_application_required"> *</p>
                  <%= form.collection_select :leavetype_refno, GenLeaveTypeM.where(Code: 'SL').or(GenLeaveTypeM.where(Code: 'LWOP')),:LeaveTypeRefNo, :Code, label: 'Leave Type ' %>

                </div>
              <% end %>


              <div class="col-sm-6" >
        
                  <p id="leave_application_required"> *</p>
                  <%= form.collection_select :end_hrs, PortalLeaveTimeLookupU.all.order('leave_value ASC'),:leave_value, :description, label:'Hours' %>

                
              </div>
          </div>

          <div class="row">
              <div class="col-sm-6" >
                <p id="leave_application_required"> *</p>
                <%= form.date_field :startdate, label: 'Start Date', id:'start_date', min: '2019-01-01', max: '2022-01-01' %>
            
              </div>

              <div class="col-sm-6" >
                <p id="leave_application_required"> *</p>
                <%= form.date_field :enddate, label: 'End Date', id:'end_date', min: '2019-01-01', max: '2022-01-01' %>
            
              </div>




          </div>

          <div class="row">
              <div class="col-sm-12" >
                <p id="leave_application_required"> *</p>
                 <%= form.text_area :reason %>

              </div>
              
          </div>

          <br>
          <br>



          <div class="row">
              <div class="col-sm-6" align="left">
                 <%= form.submit 'Apply', id: 'submit_button', class:'btn btn-primary btn-block btn-sm' %>

            
              </div>
              <div class="col-sm-2" >

                
              </div>
              <div class="col-sm-2" >

   
                
              </div>
          </div>

        </div>
        <!--- end panel body --->
      </small>
      </div>


    </div>


    <div class="col-sm-4" >
      
    </div>



  </div>

</div>

<br>
<br>
<br>

<% end %>



<!-- start date checker -->
<script>

  if ($("#start_date").val() != $("#end_date").val() ) 
    {
      document.getElementById("portal_leave_application_end_hrs").selectedIndex = 4;
      $( "#portal_leave_application_end_hrs" ).prop('disabled', true);

      
    }
  else if ($("#start_date").val() == '' || $("#end_date").val() == '') 
    {
      $( "#submit_button" ).prop('disabled', false);
    }
  else
    {
      /*do nothing */
      $( "#portal_leave_application_end_hrs" ).prop('disabled', false);
    }

</script>



<!---start hrs checker --->
<script type="text/javascript">

  $( "#portal_leave_application_end_hrs" ).focusout(function() {

  /*alert( "Handler for .change() called." );*/

  if ($("#start_date").val() == $("#end_date").val() && $( "#portal_leave_application_end_hrs :selected" ).val() == '0')
      {


        alert("Cannot apply greater than 8 hrs for a day.");
        $( "#portal_leave_application_end_hrs" ).prop('disabled', false);
        $( "#submit_button" ).prop('disabled', true);

      }

  else if ($("#start_date").val() != $("#end_date").val() && $( "#portal_leave_application_end_hrs :selected" ).val() != '8') 
      {
        alert("Cannot accept less than 8 hours on a multiple day leave.");
        $( "#submit_button" ).prop('disabled', true);
        
      }

  else if ($("#start_date").val() > $("#end_date").val() && $( "#portal_leave_application_end_hrs :selected" ).val() == '8') 
      {
        alert("Start Date is greater than End Date");
        $( "#submit_button" ).prop('disabled', true);
        
      }

  else
      { 
          /*alert("Cannot apply greater than 8 hrs for a day.");*/
          $( "#portal_leave_application_end_hrs" ).prop('disabled', false);
          $( "#submit_button" ).prop('disabled', false);

      }
});
</script>

