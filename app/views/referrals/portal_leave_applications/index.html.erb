<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" type="text/css" href="http://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/css/jquery.dataTables.css">
</head>
<body>

<div class="container-fluid">



  <div class="row">
    
    <div class="col-sm-1" >
      <!--- empty --->
    </div>
    <div class="col-sm-10" >
      <div class="panel panel-default" id="panelframe">
          <div class="panel-heading" align="center" id="panelheader" >
            <div class="row">
              <div class="col-sm-3" >
                <h4 align="left"><i class="fas fa-calendar-check"></i>My Leave Applications</h4>
              </div>
              <div class="col-sm-6" >
                
              </div>
              <div class="col-sm-3" >
                <%= link_to 'Create Leave Application'.html_safe, new_portal_leave_application_path, class:'btn btn-primary btn-block btn-sm' %> 
              </div>
            </div>             
          </div>
        <div class="panel-body">
          <div class="table table-responsive  ">  

            <table id="example">
                <thead>
                    <tr>
                      <th align="center"><small>Leave Ref No.</small></th>
                      <th><small>Date Filed</small></th>
                      <th><small>Leave Type</small></th>
                      <th><small> Start Date</small></th>
                      <th><small>End Date</small></th>
                      <th><small>Total Hour(s)</small></th>
                      <th align="center"><small>Reason</small></th>
                      <th><small>Status</small></th>
                      <th><small></small></th> 
                    </tr>
                </thead>
                <tbody>
                     <% @portal_leave_applications.each do |portal_leave_application| %>
                    <tr><small>
                        <td align="center"><%= portal_leave_application.id %></td>
                        <td align="center"><%= portal_leave_application.created_at.strftime("%m/%d/%Y") %></td>
                        <td align="center"><% portal_leave_application.leavetype_refno %> <%=  GenLeaveTypeM.where(LeaveTypeRefNo: portal_leave_application.leavetype_refno).pluck(:Code).to_sentence%></td>
                        <td align="center"><%= portal_leave_application.startdate.strftime("%m/%d/%Y") %></td>
                        <td align="center"><%= portal_leave_application.enddate.strftime("%m/%d/%Y") %></td>
                        <td align="center"><%= PortalLeaveTimeLookupU.where(leave_value: portal_leave_application.end_hrs).pluck(:description).to_sentence %></td>
                        <td align="left"><% var_reason = portal_leave_application.reason %> <%= raw var_reason[0...25]%>...</td>
                        <td align="left"><%= PortalLeaveStatusC.where(status_refno: portal_leave_application.leave_status_refno).pluck(:status_description).to_sentence %></td>
                        <td align="center">

                          <% if portal_leave_application.leave_status_refno !=  1 %>

                            <%= link_to '<i class="far fa-file"></i> View'.html_safe, portal_leave_application, class:'btn btn-sm btn-default btn-block', :title => 'View', :rel => 'too-groupltip'%>

                          <% else %>

                            <div class="btn-group btn-group-sm btn-group-block btn-group-block" role="group" >


                            <% if @is_manager == 'true' %>
                                <%= link_to '<i class="far fa-paper-plane"></i>'.html_safe, auto_approve_path(id: portal_leave_application.id, emp_refno: portal_leave_application.employeerefno ), method: "post", data: { confirm: 'Once the application was submitted, it cannot be amend but it can be cancel.' }, class:'btn btn-sm btn-default', :title => 'Post', :rel => 'tooltip'%>

                            <% else%>
                            
                               <%= link_to '<i class="far fa-paper-plane"></i>'.html_safe, portal_leave_applications_leave_submit_path(id: portal_leave_application.id, emp_refno: portal_leave_application.employeerefno ), method: "post", data: { confirm: 'Once the application was submitted, it cannot be amend but it can be cancel.' }, class:'btn btn-sm btn-default', :title => 'Post', :rel => 'tooltip'%>
                            
                                
                            <% end %>

                            <%= link_to '<i class="far fa-edit"></i>'.html_safe, edit_portal_leave_application_path(portal_leave_application) , class:'btn btn-sm btn-default ', :title => 'Edit', :rel => 'tooltip' %>

                            <%= link_to '<i class="far fa-file"></i>'.html_safe, portal_leave_application, class:'btn btn-sm btn-default', :title => 'View', :rel => 'tooltip'%>

                            <%= link_to '<i class="far fa-trash-alt"></i>'.html_safe, portal_leave_application, method: :delete, data: { confirm: 'Are you sure you want to remove this application?' }, class:'btn btn-sm btn-default', :title => 'Remove', :rel => 'tooltip' %>

                          </div>
                          <% end %>

                        </td>
                      </small>
                    </tr>
                    <% end %>
                </tbody>
            </table> 
            
            <script type="text/javascript" charset="utf8" src="http://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.8.2.min.js"></script>
            <script type="text/javascript" charset="utf8" src="http://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/jquery.dataTables.min.js"></script>
            <script>
            $(function(){
              $("#example").dataTable();
            })
            </script>
                 
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-1" >
      <!--- empty --->
    </div>

  </div>

</div>

<br>
<br>
<br> 


</body>
</html>



