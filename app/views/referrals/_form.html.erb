<!DOCTYPE html>
<html>
<head>

 <%= stylesheet_link_tag 'referral'%>
 <%= javascript_include_tag 'referral' %>


</head>


<body>
<% @current_user.id %>
<% getcur_userrefno = User.where(id: @current_user.id ).pluck(:employeerefno).to_sentence  %>
<% getcur_userrefno %>

<%= bootstrap_form_with(model: referral, local: true) do |form| %>
            <% if referral.errors.any? %>
              <div id="error_explanation">
              
                <ul>
                <% referral.errors.full_messages.each do |message| %>

                  
                  <div class="alert1" role="alert" align="center">
                  <span class="closebtn" onclick="this.parentElement.style.display='none';">&times;</span> 
                  <p class="alert" align = 'center'><%= message %></p> 
                  </div>   

                <% end %>
                </ul>
              </div>
            <% end %>


<div class="container">
  <div class="row">
    <div class="col-sm-1"  >
      <!--empty-->
    </div>

    <div class="col-sm-10">

      <div class="panel panel-default">
        <div class="panel-heading">
          <h4><strong> <i class="fas fa-users"></i> Referrals </strong></h4>
        </div>

        <div class="panel-body">
          <div class="col-sm-6" >

              <div>
                <p id="deskasteriskrefer1">*</p>
                <%= form.text_field :name, id: :referral_name, label: "Name" %>
              </div>


               <div>
                <p id="deskasteriskrefer1">*</p>
                <%= form.text_field :contact, id: :referral_contact, label: 'Contact Number / Email Address / Social Media' %>
              </div>
          
             
 

          
          </div>

          <div class="col-sm-6" >

            <div>
              <p id="deskasteriskrefer3">*</p>
              <%= form.text_field :skills, id: :referral_skills, label: "Skills"  %>
            </div>  

            <div>
              <%= form.text_area :remarks, id: :referral_remarks, label: "Remarks" %>
            </div>


            <%= form.hidden_field :employeerefno, :value => getcur_userrefno, :readonly => 'true' %>

           

            <br>

            <div class="actions">
              <%= form.submit "Send Details", class: 'btn btn-primary  btn-block btn-lg' %>
            </div>
            <% end %>

              <div align="center">
                <br>
                <p><strong>or</strong> </p>
                <p>send your friend's updated CV to: <a href="mailto:webmaster@ipiphil.com">webmaster@ipiphil.com </a></p>

              </div>

            
            
          </div>

        </div>
      </div>



    </div>

    <div class="col-sm-1" >
      <!---empty-->
    </div>

    <br>
  </div> 
</div> 

<br>

</body>
</html>








