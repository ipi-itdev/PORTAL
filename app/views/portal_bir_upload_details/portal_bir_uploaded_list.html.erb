<% if current_user.IsAdmin == true %>


<div class="container-fluid">
  <div class="row">
    <div class="col-sm-3" >
    </div>

    <div class="col-sm-6" >

      <p id="notice"><%= notice %></p>

      <h1>Uploaded BIR Forms - Admin </h1>

      <div class="table  ">
      <table class="table" >
        <thead>
          <tr>
            <th>ID</th>
            <th>Employee Name </th>
             <th>Form</th>
            <th>Created Date</th>
            <th colspan="3"></th>
          </tr>
        </thead>

        <tbody>
          <% @portal_bir_upload_details.each do |portal_bir_upload_detail| %>
            <tr>
              <td><%= portal_bir_upload_detail.id %></td>
              <td>
                <%= portal_bir_upload_detail.Employee_Name %>
              </td>

              <td>
                <%= portal_bir_upload_detail.Form %>
              </td>

              <td>
                <%= portal_bir_upload_detail.CreatedDate.to_datetime.strftime("%m/%d/%Y %H:%M") %>
              </td>
              <td>
                <% get_path = portal_bir_upload_detail.AttachmentFile %>
                <%= link_to 'Show', "/uploads/portal_bir_upload_detail/AttachmentFile/#{portal_bir_upload_detail.id}/#{get_path.to_s}", target: :blank %>
                <% get_path = portal_bir_upload_detail.AttachmentFile %>
                  <% if @get_deletebut_setting.to_i == 1 # true %>
                    <%= link_to 'Delete', portal_bir_upload_remove_path(EmpRefNo: portal_bir_upload_detail.EmployeeRefNo, ID: portal_bir_upload_detail.id ), method:'POST', data: { confirm: 'Are you sure?' } %>
                  <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

        <br>

      </div>
    </div>
    <div class="col-sm-3" >
    </div>

  </div>
</div>

<% else %>

<div class="panel-body">

<div class="container-fluid">
  <div class="row">
    <div class="col-sm-3" >
    </div>

    <div class="col-sm-6" >

      <p id="notice"><%= notice %></p>

      <h1>My Uploaded BIR Forms </h1>

      <div class="table  ">
      <table class="table" >
        <thead>
          <tr>
            <th>ID</th>
            <th>Employee Name </th>
            <th>Form</th>
            <th>Created Date</th>
            <th colspan="3"></th>
          </tr>
        </thead>

        <tbody>
          <% @portal_bir_upload_details.each do |portal_bir_upload_detail| %>
            <tr>
              <td><%= portal_bir_upload_detail.id %></td>
              <td>
                <%= portal_bir_upload_detail.Employee_Name %>
              </td>

              <td>
                <%= portal_bir_upload_detail.Form %>
              </td>

              <td>
                <%= portal_bir_upload_detail.CreatedDate.to_datetime.strftime("%m/%d/%Y %H:%M") %>
              </td>
              <td>
              <% @get_name = PisEmployeeU.where(EmployeeRefNo:portal_bir_upload_detail.EmployeeRefNo).pluck(:Description).to_sentence %>
              <% @parts = @get_name.split(", ") %> 
              <% @first_middle_names = @parts[1].split(" ") %>
              <% @formatted_name = ([@parts[0]] + @first_middle_names).join("_") %>
              <% @formatted_name = @formatted_name.upcase %>
              <% @formatted_name = @formatted_name.gsub('.', '') %>


            <% get_path = portal_bir_upload_detail.AttachmentFile %>
            <%= link_to 'Show', "/IPI_2316_2023/#{current_user.EmployeeRefNo}_#{@formatted_name}.pdf", target: :blank %>
                <%= link_to 'Show', "/uploads/portal_bir_upload_detail/AttachmentFile/#{portal_bir_upload_detail.id}/#{get_path.to_s}", target: :blank %>
                <% if @get_deletebut_setting.to_i == 1 # true %>
                  <%= link_to 'Delete', portal_bir_upload_remove_path(EmpRefNo: portal_bir_upload_detail.EmployeeRefNo, ID: portal_bir_upload_detail.id ), method:'POST', data: { confirm: 'Are you sure?' } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

        <br>

      </div>
    </div>
    <div class="col-sm-3" >
    </div>

  </div>
</div>


<% end %>