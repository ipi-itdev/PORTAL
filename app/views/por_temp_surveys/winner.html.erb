<!DOCTYPE html>
<html>

<body onload="OnLoadFunc()">



<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#winnerModal" style="visibility: hidden;" id= "winnerbutton">
  .
</button>

<!-- Modal -->
<div class="modal fade" id="winnerModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog " role="document" >
    <div class="modal-content">
      <div class="modal-body">
           <img src="/winner.png" alt="bulletin1" width="100%" height="100%">
           <%= button_to 'Close', '/confirm_winner', class:'btn btn-primary btn-block', id:'close_but', data: { disable_with: "Please wait..." }, method: 'post'   %>
      </div>
    </div>
  </div>
</div>
<!--- hrc winners /ads -->



<script>
  //onload page
function OnLoadFunc() {
      $("#winnerbutton").click();
}
</script>


</body>
</html>

