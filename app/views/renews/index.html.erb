<p id="notice"><%= notice %></p>

<h1>Renews</h1>

<table>
  <thead>
    <tr>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @renews.each do |renews| %>
      <tr>
        <td><%= link_to 'Show', renews %></td>
        <td><%= link_to 'Edit', edit_renews_path(renews) %></td>
        <td><%= link_to 'Destroy', renews, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Renews', new_renews_path %>
