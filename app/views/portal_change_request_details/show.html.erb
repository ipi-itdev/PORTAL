<!DOCTYPE html>
<html>
<head>

  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>
  
</head>
<body>

<div class="container-fluid">
<h5>Change Request Details</h5>
<br>

    <div class="row">
      <div class="col-sm-3" >
            <strong>ID: </strong>
      </div>

      <div class="col-sm-9" >
           <%= @portal_change_request_detail.ID %>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3" >
            <strong>Change Request Type: </strong>
      </div>

      <div class="col-sm-9" >
           <%=  GenChange RequestTypeM.where(Change RequestTypeRefNo: @portal_change_request_detail.Change RequestTypeRefNo).pluck(:Description).to_sentence %>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3" >
            <strong>Date: </strong>
      </div>

      <div class="col-sm-9" > 
          <%= @portal_change_request_detail.WorkDate.strftime("%m/%d/%Y") %>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3" >
        <strong>Change Request Type: </strong>
      </div>

      <div class="col-sm-9" >
        <%=  PortalChange RequestApplicationCredit.where(Change RequestCreditTypeRefNo: @portal_change_request_detail.Change RequestCreditTypeRefNo).pluck(:Description).to_sentence %>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3" >
            <strong>Reason: </strong>
      </div>

      <div class="col-sm-9" >
           <%= @portal_change_request_detail.Reason %>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3" >
            <strong>Attached File: </strong>
      </div>

      <div class="col-sm-9" >
             <small><a href="<%= @portal_change_request_detail.AttachmentFile%>" target="_blank"> <%= @portal_change_request_detail.AttachmentFile_identifier %> </a> </small>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3" >
        
      </div>
      <div class="col-sm-9" >
        <br>
        <br>
          <%= link_to 'Back to List', portal_change_request_details_path, class:'btn btn-primary btn-sm' %>
      </div>

    </div>

    <hr>

    </div>





</body>
</html>




