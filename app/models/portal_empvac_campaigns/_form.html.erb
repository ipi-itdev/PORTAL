<!DOCTYPE html>
<html>
<head>


<style type="text/css">

  #modalbut {
    visibility: hidden;
  }

    #submitbutton {
    visibility: hidden;
  }
  

  
</style>
  
</head>

<body onload="myFunction()">

  <script>
  function myFunction() {
     
    $('#modalbut').click();

  }
  </script>


<%= form_with(model: portal_empvac_campaign, local: true) do |form| %>



<!-- Button trigger modal -->
<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModal" id="modalbut">
  .
</button>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-keyboard="false" data-backdrop="static">
  <div class="modal-dialog" role="document">
    <div class="modal-content">

      <div class="modal-body">

        <%= form.hidden_field :EmployeerRefNo, value: current_user.EmployeeRefNo %>
        <%= form.hidden_field :IsDone, value: true %>


        <video  width="440px"  autoplay="autoplay"  muted="true" controls id="EmpVacCampaign" style=" width: 100%; height: 100%" >
          <source src="/Vaccine - IPI.mp4" type="video/mp4" >
          Your browser does not support the video tag.
        </video>

 
        <script>
        var aud = document.getElementById("EmpVacCampaign");
        aud.onended = function() {
          alert("The video has ended. Click Ok to proceed to Homepage ");
          $('#submitbutton').click();
        };
        </script>


        <%= form.submit '.', id:'submitbutton'%>


      </div>
      <div class="modal-footer">

      </div>
    </div>
  </div>
</div>



<% end %>

</body>
</html>


