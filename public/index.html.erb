<!DOCTYPE html>
<html>
<head>
  <title></title>

  <%= stylesheet_link_tag 'page', media: 'all', 'data-turbolinks-track': 'reload' %>


<style type="text/css">
  
#div_container_webinar{

    z-index: -1;
  }

#register_button{
  position: absolute;
  bottom: 25px;
  left: 105px;
  padding: 5px 12px;

}


#register_button_mobile{
  position: absolute;
  bottom: 19px;
  left: 75px;
  padding: 3px 6px;

}


</style>

</head>
<body>

<% if user_signed_in? == true %>



<div class="container" >
      <div class="row" >

        <div class="col-sm-8" >

          <% if @gettodayis == @getuserbday%>
                <h2><strong>Hello, <%= @getfname %>!</strong></h2> 
               <div class="row">
                <div class="col-sm-4" >
                    
                    <div class="dialog-birthday_message" align="left">
                      <div id="birthday_container" class="birthday_container" align="left">
                      <div class="balloons" align="left">
                        <div class="balloon" align="center"><strong>H</strong></div>
                        <div class="balloon" align="center"><strong>A</strong></div>
                        <div class="balloon" align="center"><strong>P</strong></div>
                        <div class="balloon" align="center"><strong>P</strong></div>
                        <div class="balloon" align="center"><strong>Y</strong></div>
                      </div>
                     </div>
                    </div>
                </div>
                <div class="col-sm-6" >
                  <div class="dialog-birthday_message" align="left">
                      <div id="birthday_container" class="birthday_container" align="left">
                      <div class="balloons" align="left">
                        <div class="balloon" align="center"><strong>B</strong></div>
                        <div class="balloon" align="center"><strong>I</strong></div>
                        <div class="balloon" align="center"><strong>R</strong></div>
                        <div class="balloon" align="center"><strong>T</strong></div>
                        <div class="balloon" align="center"><strong>H</strong></div>
                        <div class="balloon" align="center"><strong>D</strong></div>
                        <div class="balloon" align="center"><strong>A</strong></div>
                        <div class="balloon" align="center"><strong>Y</strong></div>
                      </div>
                     </div>
                    </div>
                </div>
            
              </div>
            
           
          <% else %>

          
            <h2><strong>Hello, <%= @getfname %>!</strong></h2> 
            
   

          <% end  %> 

        </div>

         

          <div class="col-sm-4">

             <div class="dropdown pc-menu"  align="center">
              <b>Today is <%= @datetodayis %></b> 
             </div>

              <div class="mobile-menu" align="left">
                <b>Today is <%= @datetodayis %></b> 
              </div>

          </div>



        </div>


    <!--advertisement -->

    <div class="row">
  
      <div class="col-sm-12" align="center" >
        <hr>
         <%= link_to image_tag("/assets/banner2.jpg", id:'hide',:class => 'responsive', :title => 'Refer a Friend', :rel => 'tooltip'), new_referral_path, :title => 'Refer a Friend', :rel => 'tooltip'  %>

         
      </div>
 
    </div>

    <!--end advertisement -->

    
    <div class="row" >
    

    <div class="col-sm-8" >

          <div class="mobile-menu" align="left" >
                <%= link_to 'Daily Health Survey', '/ODHD',class: 'btn btn-primary btn-block btn-lg' %>
                <br>
                <br> 

            <!---webinar mobile-->
            <div class="panel panel-default" id="panelframe" align="center">

              <div  class="panel-body">

      
                <div id="div_container_webinar">

                    <img src="/healthycookingwithapj.png"  style="width:100%;height:100%;">

                  </div>

                  <div class="row">
                    <div class="col-sm-12">
                      <%= button_to 'Click Here To Register', create_checker_path ,id:'register_button_mobile', class:'btn btn-success', method:'post'%>
                    </div>
                  
                  </div>

              </div>
 
            </div>
            <!---webinar mobile-->




            <div class="panel panel-default" id="panelframe" align="center">

                
                  <img src="/HotlinePITS.jpg" class="img-fluid" alt="Responsive image" style="width:100%;height:100%;">
                   <div  class="panel-body" align="justify">
                    <p>Our hotlines are open during weekdays, <b>8:30 AM – 5:00 PM</b>.  Feel free to send us a message after business hours and we will prioritize your concern on the next working day (for non-emergency).</p>
                   </div>
              
            </div>






          </div>


        <!--- start faq -->

          <div class="panel panel-default" id="panelframe" align="center">     

                <%= render 'pages/faq' %>
              
          </div>

        <!--- end faq -->


        
           <!--- start announcement section desktop--> 
          <div class="dropdown pc-menu" align="left" > 

            <div class="panel panel-default" id="panelframe">
              <div  class="panel-heading" id="panelheader">
                <strong><i class="fas fa-bullhorn"></i><strong> Announcements </strong> </strong> 
              </div> 

          

              <table class="table   table-responsive " width="100%">

                <tr>
             
                  <% @getannouncements.each do |announcement|%>
                  <td width="100%">
                     <% if announcement.IsImportant == true %>
                      <strong><%= link_to announcement.title, announcement, class:"text-danger" %> <%= image_tag("/important.png", :alt => "important", width: "50", height:"50") %></strong>
                      <br>
                       <small>Posted on: <% announcedate = announcement.created_at.to_date %> <%= announcedate.strftime("%B %d, %Y ")%> @ <% announcetime = announcement.created_at.to_time %> <%= announcetime.strftime("%I:%M%p")%>

                       </small>
                    <% else %>
                      <strong><%= link_to announcement.title, announcement %> </strong>
                      <br>
                       <small>Posted on: <% announcedate = announcement.created_at.to_date %> <%= announcedate.strftime("%B %d, %Y ")%> @ <% announcetime = announcement.created_at.to_time %> <%= announcetime.strftime("%I:%M%p")%> 
                       </small>
                    <% end %>

                    <!---
                    <strong><h1><%= link_to announcement.title, announcement %></h1></strong>
                    <small>by: <%= PisEmployeeU.where(EmployeeRefno: announcement.EmployeeRefNo).pluck(:Description).to_sentence %> | <%= announcement.created_at.to_datetime %></small>
                    <hr>
                    <%=  raw sanitize(announcement.message[0..100])%> <%= link_to 'Continue Reading...', announcement %> --->
                   
                  </td>
                </tr>
                  <% end %>
              </table>
             
         

                  <div align="center">
                      <%= link_to 'See All Announcements', announcements_path %>
                  </div>
         
            </div>
          </div>
            <!-- end announcement section destop-->




        <!--- start Telemedicine  mobile --->
        <div class="mobile-menu" align="left" >
          <div class="panel panel-default" id="panelframe" align="center">
            <img src="/PITS portal_telemed.png"  style="width:100%;height:100%;">
            <img src="/PITS portal_online counselling.png"  style="width:100%;height:100%;">
          </div>
        </div>     
        <!--- end Telemedicine  mobile --->


        <!--- start poster --->    
        <div class="panel panel-default"  id="panelframe">


            <div  class="panel-body">

                <%= render 'pages/poster' %>

            </div>

        </div>
        <!--- end poster --->


          <!---start holiday section  desktop -->
            <div class="dropdown pc-menu" align="left" >

              <div  class="panel panel-info" id="holidaypanel">
              <div class="panel-heading">
              <h4><strong><i class="fas fa-calendar-alt"></i> <%= Time.current.year %> Holidays</strong></h4></div>
              <div  class="panel-body">
              <table class="table  table-hover table-responsive table-bordered">
              <th><small><i>The following were declared by virtue of Proclamation No. 269, unless otherwise specified:
              * (SNWH) Special Non-Working Holiday 
              </i></small>
              </th>
                 <tr>
                   <% @getholidays.each do |holiday|%>
                  
                   <td>
                      
                      <% holiday1 = holiday.HolidayDate.to_date %>
                      <strong><%= holiday1.strftime("%B %d, %Y - %A") %></strong>
                      <br>
                      <% if holiday.HolidayTypeRefNo == 1 %>
                      <%= holiday.Description%> (SNWH)
                      <% else %>
                      <%= holiday.Description%>

                     <% end %> 
                   </td>
                   
                   
                 </tr>

                  <% end %> 
              </table>

              </div>
              </div>  

            </div>
          <!--- end holiday section desktop -->
    </div>


    <div class="col-sm-4" >

       <div class="dropdown pc-menu" align="left" >

        
        <%= link_to 'Daily Health Survey', verify_dhs_path ,class: 'btn btn-primary btn-block btn-lg', method: "post" %>


          <br>

            <!--- start webinar  desktop --->
            <div class="dropdown pc-menu" align="left" >
              <div class="panel panel-default" id="panelframe" align="center">
                  <div id="div_container_webinar">

                    <img src="/healthycookingwithapj.png"  style="width:100%;height:100%;">

                  </div>

                  <div class="row">
                    <div class="col-sm-12" >
                      <%= link_to 'Click Here To Register', create_checker_path, class:'btn btn-success btn-md', id:'register_button', method: 'post' %>
                    </div>
                  
                  </div>


              </div>
            </div>     
            <!--- end webinar  desktop --->


          <br> 
        <div class="panel panel-default" id="panelframe" align="center">

            
              <img src="/HotlinePITS.jpg"  style="width:100%;height:100%;">
               <div  class="panel-body" align="justify">
                <p>Our hotlines are open during weekdays, <b>8:30 AM – 5:00 PM</b>.  Feel free to send us a message after business hours and we will prioritize your concern on the next working day (for non-emergency).</p>
               </div>
          
        </div>
       </div>


      <!--- start Telemedicine  desktop --->
      <div class="dropdown pc-menu" align="left" >
        <div class="panel panel-default" id="panelframe" align="center">
            <img src="/PITS portal_telemed.png"  style="width:100%;height:100%;">
            <img src="/PITS portal_online counselling.png"  style="width:100%;height:100%;">
        </div>
      </div>     
      <!--- end Telemedicine  desktop --->



      <!--- start video  --->     
      <div class="panel panel-default" id="panelframe" align="center">

            <img src="/content_covid.jpg" style="height: 100%; width: 100%;"  >
            <button type="button" class="btn btn-primary " data-toggle="modal" data-target="#VideoModal" onclick="playVid()">Watch This Video</button>

      </div>
      <!--- end video  --->



    <!--- start slider --->
    <div class="panel panel-default" id="panelframe" align="center">

      <%= render 'pages/slider' %>

    </div>  

  
    <!--- end slider --->


    <!---start holiday section  mobile -->
      <div class="mobile-menu" align="left" >

        <div  class="panel panel-info" id="holidaypanel">
        <div class="panel-heading">
        <h4><strong><i class="fas fa-calendar-alt"></i> <%= Time.current.year %> Holidays</strong></h4></div>
        <div  class="panel-body">
        <table class="table  table-hover table-responsive table-bordered">
        <th><small><i>The following were declared by virtue of Proclamation No. 269, unless otherwise specified:
        * (SNWH) Special Non-Working Holiday 
        </i></small>
        </th>
           <tr>
             <% @getholidays.each do |holiday|%>
            
             <td>
                
                <% holiday1 = holiday.HolidayDate.to_date %>
                <strong><%= holiday1.strftime("%B %d, %Y - %A") %></strong>
                <br>
                <% if holiday.HolidayTypeRefNo == 1 %>
                <%= holiday.Description%> (SNWH)
                <% else %>
                <%= holiday.Description%>

               <% end %> 
             </td>
             
             
           </tr>

            <% end %> 
        </table>

        </div>
        </div>  

      </div>
    <!--- end holiday section mobile -->


      <div  class="panel panel-info" id="logopanel">
              <div  class="panel-body" align="center">

              <img src="/pits_12.PNG" class="responsive" id="#ipi32logo" alt="pits32" >
              <hr>
              <h4 align="center"><strong>Quick Links</strong></h4>
              <hr>
              <%= link_to "My Payslip", pay_processed_payroll_us_path,  :method=> :get %>
              <%= link_to "Refer a Friend", new_referral_path, id:'hide' %>
              <br>
              <%= link_to "Contact Us", new_contactpage_path %>
              <br>
              <!---<%= link_to "Knowledge base", knowledges_path %> -->
              <br>
              <br>
             
        </div>
    </div>
  </div>

<br>
<br>


<% else #when user is not log in%> 

<div class="container-fluid">

    <div class="row">
      <div class="col-sm-8" >
      <div class="jumbotron" style="background-color:white;">
      <h2 class="display-1"><strong>IPI Employee Portal</strong></h2>
              <p class="lead"></p>
              <hr class="my-4">
              <small><p><i>"We are committed to: EXCELLENCE, SERVICE and PROFESSIONALISM" </i></p></small>
              <div class="row">
              <div class="col-sm-4" > 
                <%= button_to "Login", new_user_session_path, class: "btn btn-primary  btn-block btn-lg"%>

              </div>
              <div class="col-sm-4" ></div>
              <div class="col-sm-4" ></div>
              </div>
                   
      </div>
      </div>

      <div class="col-sm-4" align="center">
          <img src="/assets/IPI301.png" class="img-fluid" alt="Responsive image" style="width:350px;height:350px;">
      </div>

          <br>
  </div>

</div>  


</div>
   
<% end %>

<br>
<br>
<br>
<br>


<!---- start modal video --->

<!-- Modal -->
<div class="modal fade" id="VideoModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog" role="document">
    <div class="modal-content">

      <div class="modal-body">

        <video width="320" height="240" controls style=" width: 100%; height: 100%"  id="CovidVideo" >
          <source src="/Hygiene & Sanitation in the Workplace May20, 2020.mp4" type="video/mp4">
        Your browser does not support the video tag.
        </video>
      
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"  onclick="pauseVid()" >Close</button>
      </div>
    </div>
  </div>
</div>

<!---- end modal video --->



<script> 
var vid = document.getElementById("CovidVideo"); 

function playVid() { 
  vid.play(); 
} 

function pauseVid() { 
  vid.pause(); 
} 
</script> 







</body>
</html>







